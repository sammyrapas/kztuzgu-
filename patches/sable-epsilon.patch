+/* ================================================================= apps */
+
+namespace {
+
+void buildApps() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfApps = 0;
+  s_calculationIndex = -1;
+  for (int appIndex = 1; appIndex < builtin && s_numberOfApps < k_maxApps;
+       appIndex++) {
+    I18n::Message name =
+        container->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+            ->descriptor()
+            ->name();
+    AppSlot& a = s_apps[s_numberOfApps];
+    a.item = {Item::Kind::Builtin, static_cast<int16_t>(appIndex)};
+    a.name = static_cast<int16_t>(name);
+    if (name == I18n::Message::CalculApp) {
+      s_calculationIndex = s_numberOfApps;
+    }
+    s_numberOfApps++;
+  }
+  s_numberOfBuiltin = s_numberOfApps;
+  int games = container->numberOfExternalApps();
+  for (int i = 0; i < games && s_numberOfApps < k_maxApps; i++) {
+    AppSlot& a = s_apps[s_numberOfApps++];
+    a.item = {Item::Kind::External, static_cast<int16_t>(i)};
+    a.name = -1;
+  }
+  s_builtinPages = (s_numberOfBuiltin + k_perPage - 1) / k_perPage;
+  if (s_builtinPages < 1) {
+    s_builtinPages = 1;
+  }
+  int gamePages =
+      (s_numberOfApps - s_numberOfBuiltin + k_perPage - 1) / k_perPage;
+  s.numberOfPages = s_builtinPages + (gamePages > 0 ? gamePages : 1);
+  if (s.page >= s.numberOfPages) {
+    s.page = 0;
+  }
+}
+
+const char* appName(int i) {
+  if (i < 0 || i >= s_numberOfApps) {
+    return "";
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  if (s_apps[i].item.kind == Item::Kind::External) {
+    return container->externalAppAtIndex(s_apps[i].item.index).name();
+  }
+  return I18n::translate(container
+                             ->appSnapshotAtIndex(PermutedAppSnapshotIndex(
+                                 s_apps[i].item.index))
+                             ->descriptor()
+                             ->name());
+}
+
+int appAtSlot(int page, int slot) {
+  if (page < 0 || slot < 0 || slot >= k_perPage) {
+    return -1;
+  }
+  int i;
+  if (page < s_builtinPages) {
+    i = page * k_perPage + slot;
+    return i < s_numberOfBuiltin ? i : -1;
+  }
+  i = s_numberOfBuiltin + (page - s_builtinPages) * k_perPage + slot;
+  return i < s_numberOfApps ? i : -1;
+}
+
+int pageOfApp(int index) {
+  if (index < s_numberOfBuiltin) {
+    return index / k_perPage;
+  }
+  return s_builtinPages + (index - s_numberOfBuiltin) / k_perPage;
+}
+
+int slotOfApp(int index) {
+  if (index < s_numberOfBuiltin) {
+    return index % k_perPage;
+  }
+  return (index - s_numberOfBuiltin) % k_perPage;
+}
+
+// Statue of a slot, in cells
+Rect statueRect(int slot) {
+  int col = slot % 3, row = slot / 3;
+  return {12 + col * 54, 12 + row * 50, k_statueSize, k_statueSize};
+}
+
+/* Decompresses the icon of app i into the text buffer; returns its size */
+bool loadIcon(int i, int* w, int* h) {
+  KDColor* buffer = textBuffer();
+  if (!buffer || i < 0 || i >= s_numberOfApps) {
+    return false;
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  if (s_apps[i].item.kind == Item::Kind::External) {
+    Ion::ExternalApps::App app =
+        container->externalAppAtIndex(s_apps[i].item.index);
+    if (!app.iconData() || app.iconSize() == 0) {
+      return false;
+    }
+    *w = 55;
+    *h = 56;
+    OMG::Memory::Decompress(app.iconData(), reinterpret_cast<uint8_t*>(buffer),
+                            app.iconSize(), 55 * 56 * sizeof(KDColor));
+    return true;
+  }
+  Escher::ThemedImage icon =
+      container->appSnapshotAtIndex(PermutedAppSnapshotIndex(
+                                        s_apps[i].item.index))
+          ->descriptor()
+          ->icon();
+  const Escher::Image* image = icon.light();
+  if (!image || image->width() * image->height() >
+                    k_textBufferW * k_textBufferH) {
+    return false;
+  }
+  *w = image->width();
+  *h = image->height();
+  OMG::Memory::Decompress(image->compressedPixelData(),
+                          reinterpret_cast<uint8_t*>(buffer),
+                          image->compressedPixelDataSize(),
+                          *w * *h * sizeof(KDColor));
+  return true;
+}
+
+// Rounded corners of the statues (in cells)
+bool insideStatue(int lx, int ly) {
+  constexpr int r = 5;
+  int cx = lx < r ? r : (lx >= k_statueSize - r ? k_statueSize - r - 1 : lx);
+  int cy = ly < r ? r : (ly >= k_statueSize - r ? k_statueSize - r - 1 : ly);
+  int dx = lx - cx, dy = ly - cy;
+  return dx * dx + dy * dy <= r * r;
+}
+
+uint16_t iconCell(int lx, int ly, int w, int h) {
+  KDColor* buffer = textBuffer();
+  int sx = lx * w / k_statueSize, sy = ly * h / k_statueSize;
+  int sx2 = sx + 1 < w ? sx + 1 : sx, sy2 = sy + 1 < h ? sy + 1 : sy;
+  KDColor a = buffer[sy * w + sx], b = buffer[sy * w + sx2],
+          c = buffer[sy2 * w + sx], d = buffer[sy2 * w + sx2];
+  int r = (a.red() + b.red() + c.red() + d.red()) / 4;
+  int g = (a.green() + b.green() + c.green() + d.green()) / 4;
+  int bl = (a.blue() + b.blue() + c.blue() + d.blue()) / 4;
+  return KDColor::RGB888(r, g, bl);
+}
+
+uint16_t placeholderCell(int app, int lx, int ly) {
+  int hue = static_cast<int>(hash(app * 7 + 3) % 360);
+  int k = (lx + ly) * 4;
+  return hsv(hue + k / 4, 170, 150 + (k > 100 ? 100 : k));
+}
+
+/* Statue cells of the page appear in random order during the building. */
+uint32_t appearTime(int slot, int lx, int ly) {
+  return s.buildStart + slot * 70 +
+         hash(slot * 4096 + ly * 64 + lx) % (k_buildDuration - 400) +
+         (k_statueSize - 1 - ly) * 6;
+}
+
+void startBuild() {
+  s.building = true;
+  s.buildStart = s.now;
+  s.builtPage = s.page;
+}
+
+void updateBuild() {
+  if (!s.building || !g_colors) {
+    return;
+  }
+  bool done = s.now > s.buildStart + k_buildDuration + 6 * 70;
+  for (int slot = 0; slot < k_perPage; slot++) {
+    int app = appAtSlot(s.builtPage, slot);
+    if (app < 0) {
+      continue;
+    }
+    int w = 0, h = 0;
+    bool icon = false;
+    Rect r = statueRect(slot);
+    for (int ly = 0; ly < k_statueSize; ly++) {
+      for (int lx = 0; lx < k_statueSize; lx++) {
+        if (!insideStatue(lx, ly)) {
+          continue;
+        }
+        int i = (r.y + ly) * W + r.x + lx;
+        if (World::matAt(i) == Statue) {
+          continue;
+        }
+        if (!done && appearTime(slot, lx, ly) > s.now) {
+          continue;
+        }
+        if (!icon && w == 0) {
+          icon = loadIcon(app, &w, &h);
+          if (!icon) {
+            w = -1;
+          }
+        }
+        uint16_t c = icon ? iconCell(lx, ly, w, h) : placeholderCell(app, lx, ly);
+        g_grid[i] = Statue;
+        g_colors[i] = c;
+      }
+    }
+  }
+  if (done) {
+    s.building = false;
+  }
+}
+
+/* The statues of the current page are blown away: some grains fly with the
+ * wind, some fall into the desert. */
+void blowStatues(int onlySlot, int driftPercent, int dustPercent) {
+  if (!g_colors) {
+    World::clearStatues();
+    return;
+  }
+  for (int slot = 0; slot < k_perPage; slot++) {
+    if (onlySlot >= 0 && slot != onlySlot) {
+      continue;
+    }
+    Rect r = statueRect(slot);
+    for (int y = r.y; y < r.bottom(); y++) {
+      for (int x = r.x; x < r.right(); x++) {
+        int i = y * W + x;
+        if (World::matAt(i) != Statue) {
+          continue;
+        }
+        int q = static_cast<int>(rnd() % 100);
+        uint16_t c = g_colors[i];
+        if (q < driftPercent) {
+          addParticle(x * k_cell, y * k_cell,
+                      static_cast<int>(rnd() % 80) - 20,
+                      -static_cast<int>(rnd() % 60), c,
+                      180 + (rnd() & 63), Drift);
+          g_grid[i] = Air;
+        } else if (q < driftPercent + dustPercent) {
+          g_grid[i] = static_cast<uint8_t>(Dust | ((rnd() & 7) << 4));
+        } else {
+          g_grid[i] = Air;
+        }
+      }
+    }
+  }
+}
+
+void changePage(int page, int slot) {
+  if (page == s.page && !s.building) {
+    s.selected = slot;
+    return;
+  }
+  // finish the statues of the old page first, then blow them
+  s.building = false;
+  blowStatues(-1, 40, 20);
+  s.page = page;
+  s.selected = slot;
+  startBuild();
+}
+
+void select(int slot) { s.selected = slot; }
+
+void move(int dx, int dy) {
+  int col = s.selected % 3, row = s.selected / 3;
+  if (dy != 0) {
+    int nrow = row + dy;
+    if (nrow < 0 || nrow > 1) {
+      return;
+    }
+    int slot = nrow * 3 + col;
+    while (slot > 0 && appAtSlot(s.page, slot) < 0) {
+      slot--;
+    }
+    select(slot);
+    return;
+  }
+  int ncol = col + dx;
+  if (ncol < 0) {
+    int page = (s.page + s.numberOfPages - 1) % s.numberOfPages;
+    int slot = row * 3 + 2;
+    while (slot > 0 && appAtSlot(page, slot) < 0) {
+      slot--;
+    }
+    changePage(page, slot);
+    return;
+  }
+  if (ncol > 2 || appAtSlot(s.page, row * 3 + ncol) < 0) {
+    int page = (s.page + 1) % s.numberOfPages;
+    int slot = row * 3;
+    while (slot > 0 && appAtSlot(page, slot) < 0) {
+      slot--;
+    }
+    changePage(page, slot);
+    return;
+  }
+  select(row * 3 + ncol);
+}
+
+/* ======================================================== the desert */
+
+void desertTerrain() {
+  World::clear();
+  for (int x = 0; x < W; x++) {
+    float h = 10 + 3.2f * sinf(x * 0.075f) + 1.8f * sinf(x * 0.21f + 1.3f);
+    int top = H - static_cast<int>(h);
+    for (int y = H - 1; y >= top; y--) {
+      Mat m = y >= H - 2 ? Stone : Sand;
+      World::set(x, y, m);
+    }
+  }
+  // An oasis
+  for (int x = 96; x < 120; x++) {
+    float d = (x - 108) / 12.f;
+    int depth = static_cast<int>(5 * (1 - d * d));
+    for (int k = 0; k < 9; k++) {
+      int y = H - 16 + k;
+      if (World::at(x, y) == Sand) {
+        if (k < 9 - depth) {
+          World::set(x, y, Air);
+        } else if (k < 9 - depth + 3) {
+          World::set(x, y, Water);
+        }
+      }
+    }
+  }
+  // Two cacti
+  int cacti[2] = {28, 140};
+  for (int c = 0; c < 2; c++) {
+    int x = cacti[c];
+    int y = H - 1;
+    while (y > 0 && World::at(x, y) != Air) {
+      y--;
+    }
+    for (int k = 0; k < 12; k++) {
+      World::set(x, y - k, Plant);
+      World::set(x + 1, y - k, Plant);
+    }
+    for (int k = 0; k < 4; k++) {
+      World::set(x - 2 - k / 3, y - 5 - k, Plant);
+      World::set(x + 3 + k / 3, y - 7 - k, Plant);
+    }
+    World::set(x - 1, y - 5, Plant);
+    World::set(x + 2, y - 7, Plant);
+  }
+  // Rocks
+  World::blob(60, H - 6, 3, Stone, 230, true);
+  World::blob(74, H - 4, 2, Stone, 230, true);
+  // A hidden treasure (dig with acid to find it)
+  World::blob(46, H - 4, 1, Gold, 256, true);
+}
+
+}  // namespace
+
+void resetDesert() {
+  desertTerrain();
+  World::setGravity(0);
+  World::openFloor(false);
+}
