+void renderAppel(Band& b) {
+  nightBackground(b);
+  uint32_t t = now() - s_call.phaseStart;
+  if (s_call.phase == 0) {
+    title(b, "FAUX APPEL");
+    text(b, "Qui doit t'appeler ?", 160, 34, KDColor::RGB24(k_ink), Small,
+         Align::Center);
+    for (int k = 0; k <= k_numberOfCallers; k++) {
+      int y = 54 + k * 18;
+      bool sel = k == s_call.pick;
+      if (sel) {
+        roundFill(b, {60, y - 2, 200, 17}, 5, KDColor::RGB24(k_sand), 220);
+      }
+      text(b, k == k_numberOfCallers ? "Au hasard" : k_callers[k].name, 160, y,
+           sel ? KDColor::RGB24(k_night) : KDColor::RGB24(k_ink), Small,
+           Align::Center);
+    }
+    hint(b, "OK : l'appel arrive dans 5 secondes. Cache l'écran.");
+    return;
+  }
+  const Caller& c = k_callers[s_call.caller];
+  if (s_call.phase == 1) {
+    int left = 5 - static_cast<int>(t / 1000);
+    char m[8];
+    Str st(m, sizeof(m));
+    st.addInt(left < 1 ? 1 : left);
+    text(b, m, 160, 110, KDColor::RGB24(0x3A3050), Large, Align::Center);
+    return;
+  }
+  if (s_call.phase == 2) {
+    // ringing
+    for (int k = 0; k < 3; k++) {
+      float ph = ((t + k * 400) % 1200) / 1200.f;
+      ellipse(b, 160, 90, 40 + ph * 40, 40 + ph * 40,
+              KDColor::RGB24(c.color), static_cast<int>(90 * (1 - ph)));
+    }
+    avatar(b, 160, 90, 38, c);
+    outlinedText(b, c.name, 160, 140, KDColor::RGB24(0xFFFFFF), Large,
+                 Align::Center);
+    text(b, (t / 600) & 1 ? "Appel entrant..." : "Appel entrant", 160, 164,
+         KDColor::RGB24(k_dim), Small, Align::Center);
+    disc(b, 80, 205, 18, KDColor::RGB24(0xE04040));
+    disc(b, 240, 205, 18, KDColor::RGB24(0x30C060));
+    text(b, "Retour", 80, 199, KDColor::RGB24(0xFFFFFF), Small, Align::Center);
+    text(b, "OK", 240, 199, KDColor::RGB24(0xFFFFFF), Small, Align::Center);
+    return;
+  }
+  if (s_call.phase == 4) {
+    avatar(b, 160, 80, 30, c);
+    char m[96];
+    Str st(m, sizeof(m));
+    st.add("Appel refusé. ").add(c.name).add(" va s'en souvenir.");
+    int h;
+    wrapText(b, m, 160, 130, 36, KDColor::RGB24(k_ink), Align::Center, &h);
+    return;
+  }
+  // talking (3) or ended (5)
+  avatar(b, 30, 26, 16, c);
+  outlinedText(b, c.name, 54, 12, KDColor::RGB24(0xFFFFFF), Small);
+  char m[16];
+  Str st(m, sizeof(m));
+  uint32_t secs = (s_call.phase == 3 ? t : 0) / 1000;
+  if (s_call.phase == 3) {
+    st.add("0").addInt(secs / 60).add(":");
+    if (secs % 60 < 10) {
+      st.add("0");
+    }
+    st.addInt(secs % 60);
+    text(b, m, 54, 28, KDColor::RGB24(0x60E080), Small);
+  } else {
+    text(b, "Appel terminé", 54, 28, KDColor::RGB24(0xE06060), Small);
+  }
+  int n = callerLines(s_call.caller);
+  int shown = s_call.phase == 3 ? static_cast<int>(t / k_lineDelay) + 1 : n;
