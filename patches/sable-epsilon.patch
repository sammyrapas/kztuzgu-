+void sandTexture(Band& b, Rect r, int x0, int y0, int (*inside)(int, int)) {
+  Rect z = r.intersection(b.area());
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      if (!inside(x - x0, y - y0)) {
+        continue;
+      }
+      uint32_t h = hash((x >> 1) * 7919 + (y >> 1) * 31);
+      row[x] = mix(KDColor::RGB24(k_sand), KDColor::RGB24(0x9A6A30),
+                   (h & 3) * 28);
+    }
+  }
+}
