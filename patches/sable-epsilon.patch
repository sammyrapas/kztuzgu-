+
+/* SABLE: every pixel of the home screen is a grain of matter.
+ *
+ * The apps are sand statues standing in a night desert. OK blows the
+ * selected statue away like dust and opens the app. When you come back, the
+ * last image of the app crumbles into sand and falls into the desert. The
+ * results of your calculations fall from the sky, made of a material that
+ * depends on the number. The function keys are natural disasters, Var is the
+ * god mode (pour any material), Toolbox opens the Labo, Backspace is the
+ * panic button. */
+
+namespace Home {
+namespace Sable {
+
+State s;
+Memory* g_mem = nullptr;
+AppSlot s_apps[k_maxApps];
+int s_numberOfApps = 0;
+int s_numberOfBuiltin = 0;
+
+namespace {
+
+namespace Events = Ion::Events;
+using Ion::Events::Event;
+using Ion::Keyboard::Key;
+using KDFont::Size::Large;
+using KDFont::Size::Small;
+
+bool s_attached = false;
+Item s_launch = k_noItem;
+int s_calculationIndex = -1;
+int s_builtinPages = 1;
+Falling s_falling[k_maxFalling];
+uint8_t s_logo[50 * 18 / 8 + 1];
+int s_logoW = 0, s_logoH = 0;
+bool logoBit(int bit) { return (s_logo[bit >> 3] >> (bit & 7)) & 1; }
+
+// The simulator's photo session drives the clock and the keyboard itself
+bool s_fake = false;
+uint32_t s_fakeClock = 0;
+uint64_t s_fakeKeys = 0;
+
+uint32_t clockMs() {
+  return s_fake ? s_fakeClock : static_cast<uint32_t>(Ion::Timing::millis());
+}
+
+constexpr uint32_t k_freezeDuration = 1500;
+constexpr uint32_t k_buildDuration = 900;
+constexpr uint32_t k_bootDuration = 3400;
+constexpr uint32_t k_sand = 0xE6BE6E;
+constexpr uint32_t k_night = 0x0A0820;
+
+}  // namespace
+
+/* ============================================================ utilities */
+
+uint32_t rnd() {
+  s.random ^= s.random << 13;
+  s.random ^= s.random >> 17;
+  s.random ^= s.random << 5;
+  return s.random;
+}
+
+float frnd() { return (rnd() & 0xFFFF) / 65535.f; }
+
+uint32_t hash(uint32_t x) { return World::hash(x); }
+
+bool examMode() {
+  return ExamModeManager::ExamMode().ruleset() != Ion::ExamMode::Ruleset::Off;
+}
+
+bool fakeClock() { return s_fake; }
+
+Ion::Keyboard::State scanKeys() {
+  return s_fake ? Ion::Keyboard::State(s_fakeKeys) : Ion::Keyboard::scan();
+}
+
+Str& Str::add(const char* t) {
+  while (t && *t && len < size - 1) {
+    buf[len++] = *t++;
+  }
+  buf[len] = 0;
+  return *this;
+}
+
+Str& Str::addInt(long v) {
+  char tmp[24];
+  int n = 0;
+  bool neg = v < 0;
+  unsigned long u = neg ? -v : v;
+  do {
+    tmp[n++] = '0' + u % 10;
+    u /= 10;
+  } while (u && n < 22);
+  if (neg) {
+    add("-");
+  }
+  while (n > 0 && len < size - 1) {
+    buf[len++] = tmp[--n];
+  }
+  buf[len] = 0;
+  return *this;
+}
+
+Str& Str::addNumber(double v) {
+  if (v != v) {
+    return add("undef");
+  }
+  if (v < 0) {
+    add("-");
+    v = -v;
+  }
+  if (v > 1e15) {
+    // m.mmm x 10^e
+    int e = 0;
+    while (v >= 10 && e < 300) {
+      v /= 10;
+      e++;
+    }
+    long m = static_cast<long>(v * 1000 + 0.5);
+    addInt(m / 1000).add(".");
+    char d[4] = {static_cast<char>('0' + (m / 100) % 10),
+                 static_cast<char>('0' + (m / 10) % 10),
+                 static_cast<char>('0' + m % 10), 0};
+    return add(d).add("\xE1\xB4\x87").addInt(e);
+  }
+  double ip = floor(v);
+  double frac = v - ip;
+  long digits = static_cast<long>(frac * 1000000 + 0.5);
+  if (digits >= 1000000) {
+    ip += 1;
+    digits = 0;
+  }
+  addInt(static_cast<long>(ip));
+  if (digits > 0) {
+    char d[8];
+    for (int k = 5; k >= 0; k--) {
+      d[k] = '0' + digits % 10;
+      digits /= 10;
+    }
+    int end = 6;
+    while (end > 0 && d[end - 1] == '0') {
+      end--;
+    }
+    d[end] = 0;
+    add(".").add(d);
+  }
+  return *this;
+}
+
+void setMode(Mode m) {
+  s.mode = m;
+  s.modeStart = s.now;
+}
+
+void toast(const char* text, uint32_t duration) {
+  Str t(s.toast, sizeof(s.toast));
+  t.add(text);
+  s.toastStart = s.now;
+  s.toastUntil = s.now + duration;
+}
+
+void shake(uint32_t duration) {
+  if (s.now + duration > s.shakeUntil) {
+    s.shakeUntil = s.now + duration;
+  }
+}
+
+void flash(uint32_t color, uint32_t duration) {
+  s.flashColor = color;
+  s.flashUntil = s.now + duration;
+  s.flashLength = duration;
+}
+
+/* ============================================================ particles */
+
+void clearParticles() {
+  if (g_mem) {
+    memset(g_mem->particles, 0, sizeof(g_mem->particles));
+  }
+}
+
+void addParticle(int px, int py, int vx, int vy, uint16_t color, int life,
+                 ParticleKind kind) {
+  if (!g_mem) {
+    return;
+  }
+  static int cursor = 0;
+  for (int k = 0; k < k_maxParticles; k++) {
+    Particle& p = g_mem->particles[(cursor + k) % k_maxParticles];
+    if (p.life == 0) {
+      p.x = static_cast<int16_t>(px * 64);
+      p.y = static_cast<int16_t>(py * 64);
+      p.vx = static_cast<int16_t>(vx);
+      p.vy = static_cast<int16_t>(vy);
+      p.color = color;
+      p.life = static_cast<uint8_t>(life > 255 ? 255 : life);
+      p.kind = kind;
+      cursor = (cursor + k + 1) % k_maxParticles;
+      return;
+    }
+  }
+}
+
+int liveParticles() {
+  if (!g_mem) {
+    return 0;
+  }
+  int n = 0;
+  for (int k = 0; k < k_maxParticles; k++) {
+    n += g_mem->particles[k].life != 0;
+  }
+  return n;
+}
+
+namespace {
+
+void burst(int px, int py, int n, int hue) {
+  for (int k = 0; k < n; k++) {
+    float a = frnd() * 6.2832f;
+    float sp = 60 + frnd() * 160;
+    addParticle(px, py, static_cast<int>(cosf(a) * sp),
+                static_cast<int>(sinf(a) * sp),
+                static_cast<uint16_t>(
+                    hue < 0 ? KDColor::RGB888(255, 200 + (rnd() & 55), 80)
+                            : hsv(hue + static_cast<int>(rnd() % 50), 200,
+                                  255)),
+                200 + (rnd() & 55), Spark);
+  }
+}
+
+}  // namespace
+
+void updateParticles() {
+  if (!g_mem) {
+    return;
+  }
+  for (int k = 0; k < k_maxParticles; k++) {
+    Particle& p = g_mem->particles[k];
+    if (p.life == 0) {
+      continue;
+    }
+    int life = p.life;
+    switch (p.kind) {
+      case Drift: {
+        // Blown away: the wind grows, a little turbulence, it rises
+        uint32_t h = hash(k * 977 + s.now / 70);
+        p.vx += 5 + static_cast<int>(h % 9) - 4;
+        p.vy += -3 + static_cast<int>((h >> 8) % 7) - 3;
+        life -= 5;
+        break;
+      }
+      case Spark:
+        p.vy += 5;
+        life -= 7;
+        break;
+      case Confetti:
+        p.vy = p.vy + 2 > 50 ? 50 : p.vy + 2;
+        p.vx = static_cast<int16_t>(
+            40 * sinf((s.now + k * 300) / 200.f));
+        life -= 2;
+        break;
+      case Firework:
+        p.vy += 4;
+        life -= 3;
+        if (p.vy > -30) {
+          burst(p.x / 64, p.y / 64, 26, static_cast<int>(rnd() % 360));
+          life = 0;
+        }
+        break;
+      case LavaBomb:
+      case Meteor: {
+        p.vy += p.kind == Meteor ? 3 : 6;
+        int cx = p.x / 64 / k_cell, cy = p.y / 64 / k_cell;
+        bool hit = cy >= H - 1 || cx < 0 || cx >= W;
+        if (!hit && cy >= 0) {
+          Mat m = World::at(cx, cy);
+          hit = m != Air && m != Smoke && m != Fire;
+        }
+        if (p.kind == Meteor && (rnd() & 1)) {
+          addParticle(p.x / 64, p.y / 64, -p.vx / 4 + (int)(rnd() % 40) - 20,
+                      -p.vy / 4, KDColor::RGB888(255, 150 + (rnd() & 100), 40),
+                      120, Spark);
+        }
+        if (hit) {
+          int x = cx < 0 ? 0 : (cx >= W ? W - 1 : cx);
+          int y = cy >= H ? H - 1 : (cy < 0 ? 0 : cy);
+          if (p.kind == Meteor) {
+            World::explode(x, y, 10);
+            World::blob(x, y - 2, 4, Lava, 220, true);
+            shake(700);
+            flash(0xFFA040, 250);
+            burst(p.x / 64, p.y / 64, 40, -1);
+          } else {
+            World::blob(x, y - 1, 1, Lava, 256, false);
+          }
+          life = 0;
+        }
+        break;
+      }
+      default:
+        life -= 4;
+        break;
+    }
+    p.x = static_cast<int16_t>(p.x + p.vx);
+    p.y = static_cast<int16_t>(p.y + p.vy);
+    if (p.x < -64 * 8 || p.x > 64 * 330 || p.y > 64 * 250 ||
+        p.y < -64 * 120) {
+      life = 0;
+    }
+    p.life = static_cast<uint8_t>(life < 0 ? 0 : life);
+  }
+}
+
+void drawParticles(Band& b) {
+  if (!g_mem) {
+    return;
+  }
+  Rect area = b.area();
+  for (int k = 0; k < k_maxParticles; k++) {
+    const Particle& p = g_mem->particles[k];
+    if (p.life == 0) {
+      continue;
+    }
+    int x = p.x / 64, y = p.y / 64;
+    int size = (p.kind == Meteor) ? 6 : (p.kind == LavaBomb ? 3 : 2);
+    if (y + size <= area.y || y >= area.bottom()) {
+      continue;
+    }
+    int alpha = (p.kind == Drift || p.kind == Spark || p.kind == Confetti)
+                    ? (p.life > 160 ? 256 : p.life * 256 / 160)
+                    : 256;
+    fill(b, {x, y, size, size}, KDColor::RGB16(p.color), alpha);
+  }
+}
