+#pragma once
+
+/* SABLE: state shared by the shell (the home screen) and the Labo (the
+ * toolbox of absurd things to do in class). */
+
+#include <ion/events.h>
+#include <ion/keyboard.h>
+
+#include "gfx.h"
+#include "shell.h"
+#include "world.h"
+
+namespace Home {
+namespace Sable {
+
+enum class Mode : uint8_t {
+  Boot,
+  Home,
+  God,
+  Labo,  // the Labo menu, over the world
+  // Labo screens (full screen)
+  Sablier,
+  Menteuse,
+  Appel,
+  Desintegrateur,
+  Bataille,
+  Aide,
+  Reglages,
+};
+
+/* Particles: grains that fly away (the "snap"), sparks, lava bombs,
+ * fireworks. Fixed point: 1/64 pixel. They live in the home App object. */
+struct Particle {
+  int16_t x, y, vx, vy;
+  uint16_t color;
+  uint8_t life;  // 0: dead
+  uint8_t kind;
+};
+
+enum ParticleKind : uint8_t {
+  Drift = 1,   // blown away by the wind, fading (the snap)
+  Spark,       // falls, fading
+  LavaBomb,    // falls, becomes lava where it lands
+  Meteor,      // falls, explodes where it lands
+  Firework,    // goes up, then bursts into sparks
+  Confetti,    // falls slowly, swaying
+};
+
+constexpr int k_maxParticles = 384;
+
+/* RAM that only exists while the home screen is open: it is part of the
+ * home App object (the calculator has no spare RAM for it otherwise). */
+struct Memory {
+  uint16_t colors[k_cells];
+  KDColor text[k_textBufferW * k_textBufferH];
+  Particle particles[k_maxParticles];
+};
+
+// A calculation result falling from the sky
+struct Falling {
+  bool active;
+  Mat mat;
+  int8_t effect;
+  int16_t x;  // cells
+  float y, vy;
+  uint8_t w, h;
+  uint8_t bits[240];  // w x h bits, row stride w
+};
+
+constexpr int k_maxFalling = 3;
+constexpr int k_perPage = 6;
+constexpr int k_maxApps = 48;
+constexpr int k_statueSize = 28;  // cells
+
+struct AppSlot {
+  Item item;
+  int16_t name;  // I18n::Message, -1 for an external app
+};
+
+struct State {
+  uint32_t now, last;
+  Mode mode;
+  uint32_t modeStart;
+  bool booted;
+  int page, selected, numberOfPages;
+  int lastLaunched;  // index in the apps, -1 none, -2 panic
+  uint32_t foodSeen;
+  // statues of the page are being built
+  uint32_t buildStart;
+  bool building;
+  int builtPage;
+  // the return
+  uint32_t returnStart;
+  bool returning;
+  int pendingFood;
+  // toast
+  char toast[120];
+  uint32_t toastStart, toastUntil;
+  // god mode
+  int curX, curY, brush, brushSize;
+  // events
+  uint32_t shakeUntil, flashUntil, flashColor, flashLength;
+  uint32_t booms;
+  uint32_t floorUntil, rainUntil, stormUntil, volcanoUntil, psycheUntil;
+  uint32_t quakeUntil, holeUntil, goldUntil, tsunamiUntil;
+  int holeX, holeY;
+  int stalkX, stalkY, stalkLeft;
+  uint32_t boltUntil;
+  int8_t boltX[40], boltY[40];
+  int boltN;
+  uint32_t lastCount, lastCountTime;
+  // LED and backlight
+  bool ledOn, ledSet;
+  uint16_t ledLast;
+  int userBrightness, brightness;
+  // the hourglass of the class
+  bool sablierOn;
+  uint32_t sablierStart, sablierDuration;
+  int sablierPick;
+  bool sablierRang;
+  // stats
+  uint16_t launches, panics, disasters, snaps, explosions, calls, lies,
+      vaporized;
+  int laboSel;
+  uint32_t random;
+};
+
+extern State s;
+extern Memory* g_mem;
+extern AppSlot s_apps[k_maxApps];
+extern int s_numberOfApps;
+extern int s_numberOfBuiltin;
+
+// Shell helpers used by the Labo
+uint32_t rnd();
+float frnd();
+uint32_t hash(uint32_t x);
+bool examMode();
+bool fakeClock();
+Ion::Keyboard::State scanKeys();
+void setMode(Mode m);
+void toast(const char* text, uint32_t duration);
+void shake(uint32_t duration);
+void flash(uint32_t color, uint32_t duration);
+void renderFull(Band& band);
+void renderWorldLayers(Band& band);
+void drawToast(Band& band);
+void resetDesert();
+
+// Particles
+void addParticle(int px, int py, int vx, int vy, uint16_t color, int life,
+                 ParticleKind kind);
+void updateParticles();
+void drawParticles(Band& b);
+int liveParticles();
+void clearParticles();
+
+// strstr is not in the calculator's libc
+inline bool contains(const char* s, const char* needle) {
+  for (; *s; s++) {
+    const char* a = s;
+    const char* b = needle;
+    while (*a && *b && *a == *b) {
+      a++;
+      b++;
+    }
+    if (!*b) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/* Small string builder */
+struct Str {
+  char* buf;
+  int size;
+  int len;
+  Str(char* b, int sz) : buf(b), size(sz), len(0) { buf[0] = 0; }
+  Str& add(const char* t);
+  Str& addInt(long v);
+  Str& addNumber(double v);
+};
+
+namespace Labo {
+void open(Mode m);
+bool handleMenu(Ion::Events::Event e);
+void renderMenu(Band& b);
+bool handleEvent(Ion::Events::Event e);
+void update();
+void render(Band& b);
+uint16_t ledColor(int* intensity);
+// The hourglass of the class, shown on the home screen
+void renderSablierBadge(Band& b);
+void updateSablier();
+#if !PLATFORM_DEVICE
+// The simulator's photo session of the Labo
+void photos(void (*shoot)(const char*), void (*step)(int, const char*, int),
+            void (*press)(Ion::Events::Event, int, const char*, int));
+#endif
+}  // namespace Labo
+
+}  // namespace Sable
+}  // namespace Home
