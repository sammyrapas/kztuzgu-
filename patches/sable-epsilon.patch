+
+bool reglagesEvent(Event e) {
+  if (e == Events::Up) {
+    s_set.sel = (s_set.sel + 2) % 3;
+    s_set.confirmReset = false;
+  } else if (e == Events::Down) {
+    s_set.sel = (s_set.sel + 1) % 3;
+    s_set.confirmReset = false;
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (s_set.sel == 0) {
+      s.ledOn = !s.ledOn;
+    } else if (s_set.sel == 1) {
+      if (s_set.confirmReset) {
+        resetDesert();
+        s_set.confirmReset = false;
+        toast("Le désert est comme neuf.", 1500);
+        back();
+      } else {
+        s_set.confirmReset = true;
+      }
+    } else {
+      back();
+    }
+  } else if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+    back();
+  }
+  return true;
+}
