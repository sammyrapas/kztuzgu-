+
+/* ================================================================ toast */
+
+void drawToast(Band& b) {
+  if (s.now >= s.toastUntil) {
+    return;
+  }
+  uint32_t t = s.now - s.toastStart;
+  int alpha = t < 150 ? static_cast<int>(t * 256 / 150) : 256;
+  if (s.toastUntil - s.now < 300) {
+    alpha = static_cast<int>((s.toastUntil - s.now) * 256 / 300);
+  }
+  // Wrapped lines
+  const char* lines[4];
+  int lens[4];
+  int count = 0;
+  const char* p = s.toast;
+  constexpr int k_columns = 42;
+  while (*p && count < 4) {
+    const char* start = p;
+    const char* lastSpace = nullptr;
+    int glyphs = 0;
+    const char* q = p;
+    while (*q && *q != '\n') {
+      if (*q == ' ') {
+        lastSpace = q;
+      }
+      if ((static_cast<uint8_t>(*q) & 0xC0) != 0x80) {
+        glyphs++;
+      }
+      if (glyphs > k_columns) {
+        break;
+      }
+      q++;
+    }
+    const char* end = q;
+    if (*q && *q != '\n' && lastSpace) {
+      end = lastSpace;
+    }
+    lines[count] = start;
+    lens[count] = static_cast<int>(end - start);
+    count++;
+    p = end;
+    if (*p == ' ' || *p == '\n') {
+      p++;
+    }
+  }
+  int h = count * 15 + 10;
+  int y = 238 - h - (s.mode == Mode::God ? 22 : 0);
+  Rect r = {8, y, 304, h};
+  if (r.bottom() <= b.area().y || r.y >= b.area().bottom()) {
+    return;
+  }
+  roundFill(b, r, 6, KDColor::RGB24(0x1A1030), alpha * 220 / 256);
+  roundFrame(b, r, 6, KDColor::RGB24(k_sand), alpha);
+  for (int k = 0; k < count; k++) {
+    char line[160];
+    int n = lens[k] < 159 ? lens[k] : 159;
+    memcpy(line, lines[k], n);
+    line[n] = 0;
+    text(b, line, 160, y + 5 + k * 15, KDColor::RGB24(0xF4E8D0), Small,
+         Align::Center, 320, alpha);
+  }
+}
+
+/* ============================================================ rendering */
+
+void renderWorldLayers(Band& band) {
+  World::render(band, s.now);
+  if ((s.mode == Mode::Home || s.mode == Mode::Labo || s.mode == Mode::God) &&
+      !s.returning) {
+    drawStatueDecor(band);
+  }
+  drawHole(band);
+  drawFalling(band);
+  drawBolt(band);
+  drawParticles(band);
+}
+
+void Shell::render(Band& band) {
+  Rect area = band.area();
+  int shakeY = 0;
+  if (s.now < s.shakeUntil) {
+    shakeY = static_cast<int>(hash(s.now / 30) % 7) - 3;
+  }
+  if (shakeY != 0) {
+    band.begin({area.x, area.y + shakeY, area.w, area.h});
+  }
+  if (s.mode >= Mode::Sablier) {
+    Labo::render(band);
+    drawParticles(band);
+  } else {
+    renderWorldLayers(band);
+    if (s.mode == Mode::Boot) {
+      drawBoot(band);
+    } else if (s.mode == Mode::God) {
+      drawGod(band);
+    } else if (!s.returning) {
+      drawHud(band);
+    }
+    if (s.mode == Mode::Labo) {
+      Labo::renderMenu(band);
+    }
+  }
+  if (shakeY != 0) {
+    band.begin(area);
+  }
+  if (s_curtain > 0) {
+    renderCurtain(band, s_curtain);
+  }
+  if (s.now < s.flashUntil) {
+    int alpha = static_cast<int>((s.flashUntil - s.now) * 150 /
+                                 (s.flashLength ? s.flashLength : 1));
+    fill(band, area, KDColor::RGB24(s.flashColor), alpha);
+  }
+  drawToast(band);
+}
+
+void renderFull(Band& band) {
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    Shell::render(band);
+    if (!s_fake) {
+      Ion::Display::pushRect(KDRect(area.x, area.y, area.w, area.h),
+                             band.pixels());
+    }
+  }
+}
