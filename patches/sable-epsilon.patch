+void formatLeft(Str& m, uint32_t ms) {
+  uint32_t sec = (ms + 999) / 1000;
+  uint32_t min = sec / 60;
+  sec %= 60;
+  if (min >= 60) {
+    m.addInt(min / 60).add(" h ");
+    min %= 60;
+    if (min < 10) {
+      m.add("0");
+    }
+    m.addInt(min);
+    return;
+  }
+  m.addInt(min).add(":");
+  if (sec < 10) {
+    m.add("0");
+  }
+  m.addInt(sec);
