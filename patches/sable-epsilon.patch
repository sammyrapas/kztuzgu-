+  if (left < 60000) {
+    return "Moins d'une minute. Range ta trousse. Doucement.";
+  }
+  if (f < 0.1f) {
+    return "Ça sent la sonnerie.";
+  }
+  if (f < 0.25f) {
+    return "Plus qu'un quart. Tiens bon.";
+  }
+  if (f < 0.5f) {
+    return "Plus de la moitié ! Le plus dur est fait. (C'est faux.)";
+  }
+  if (f < 0.75f) {
+    return "Un quart de fait. Seulement.";
+  }
+  return "C'est parti. Courage.";
+}
