+/* ===================================================== falling results */
+
+namespace {
+
+enum Effect : int8_t {
+  NoEffect,
+  Boom,
+  Hole,
+  Vanish,
+  Fireworks,
+  Crash,
+  Tiny,
+};
+
+bool parseNumber(const char* t, double* out) {
+  const uint8_t* p = reinterpret_cast<const uint8_t*>(t);
+  bool neg = false;
+  if (*p == '-') {
+    neg = true;
+    p++;
+  } else if (p[0] == 0xE2 && p[1] == 0x88 && p[2] == 0x92) {
+    neg = true;
+    p += 3;
+  }
+  double v = 0;
+  int digits = 0;
+  while (*p >= '0' && *p <= '9') {
+    v = v * 10 + (*p - '0');
+    p++;
+    digits++;
+  }
+  if (*p == '.') {
+    p++;
+    double f = 0.1;
+    while (*p >= '0' && *p <= '9') {
+      v += (*p - '0') * f;
+      f /= 10;
+      p++;
+      digits++;
+    }
+  }
+  if (digits == 0) {
+    return false;
+  }
+  // exponent: E or the small capital E of Epsilon (U+1D07)
+  if (*p == 'E' || *p == 'e' || (p[0] == 0xE1 && p[1] == 0xB4 && p[2] == 0x87)) {
+    p += (*p == 0xE1) ? 3 : 1;
+    bool eneg = false;
+    if (*p == '-') {
+      eneg = true;
+      p++;
+    } else if (p[0] == 0xE2 && p[1] == 0x88 && p[2] == 0x92) {
+      eneg = true;
+      p += 3;
+    }
+    int e = 0;
+    while (*p >= '0' && *p <= '9') {
+      e = e * 10 + (*p - '0');
+      p++;
+    }
+    v *= pow(10.0, eneg ? -e : e);
+  }
+  if (*p != 0) {
+    return false;
+  }
+  *out = neg ? -v : v;
+  return true;
+}
+
+bool isPrime(long n) {
+  if (n < 2) {
+    return false;
+  }
+  for (long d = 2; d * d <= n; d++) {
+    if (n % d == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void spawnFalling(const char* text, Mat mat, Effect effect, int column) {
+  Falling* f = nullptr;
+  for (int k = 0; k < k_maxFalling; k++) {
+    if (!s_falling[k].active) {
+      f = &s_falling[k];
+      break;
+    }
+  }
+  if (!f || !textBuffer()) {
+    return;
+  }
+  uint8_t mask[106 * 18];
+  int w = 0, h = 0;
+  textMask(text, Large, mask, 106, 18, &w, &h);
+  if (w <= 0 || h <= 0) {
+    return;
+  }
+  memset(f->bits, 0, sizeof(f->bits));
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      if (mask[y * 106 + x]) {
+        int b = y * w + x;
+        f->bits[b >> 3] |= 1 << (b & 7);
+      }
+    }
+  }
+  f->w = static_cast<uint8_t>(w);
+  f->h = static_cast<uint8_t>(h);
+  f->x = static_cast<int16_t>(clampi(column - w / 2, 0, W - w));
+  f->y = -static_cast<float>(h) - static_cast<float>(rnd() % 10);
+  f->vy = 0.3f;
+  f->mat = mat;
+  f->effect = effect;
+  f->active = true;
+}
+
+inline bool fallingBit(const Falling& f, int x, int y) {
+  int b = y * f.w + x;
+  return (f.bits[b >> 3] >> (b & 7)) & 1;
+}
+
+void land(Falling& f) {
+  int y0 = static_cast<int>(f.y);
+  int cx = f.x + f.w / 2, cy = y0 + f.h / 2;
+  if (f.effect == Vanish) {
+    for (int y = 0; y < f.h; y++) {
+      for (int x = 0; x < f.w; x++) {
+        if (fallingBit(f, x, y) && (rnd() & 1)) {
+          addParticle((f.x + x) * k_cell, (y0 + y) * k_cell,
+                      static_cast<int>(rnd() % 60) - 30,
+                      -static_cast<int>(rnd() % 40),
+                      static_cast<uint16_t>(World::sample(f.mat)), 200, Drift);
+        }
+      }
+    }
+    f.active = false;
+    return;
+  }
+  for (int y = 0; y < f.h; y++) {
+    for (int x = 0; x < f.w; x++) {
+      if (fallingBit(f, x, y)) {
+        int wx = f.x + x, wy = y0 + y;
+        if (World::inside(wx, wy) && World::at(wx, wy) != Statue) {
+          World::set(wx, wy, f.mat);
+        }
+      }
+    }
+  }
+  switch (f.effect) {
+    case Boom:
+      World::explode(cx, cy, 14);
+      shake(800);
+      flash(0xFFFFFF, 200);
+      burst(cx * k_cell, cy * k_cell, 50, -1);
+      break;
+    case Hole:
+      s.holeX = cx;
+      s.holeY = cy;
+      s.holeUntil = s.now + 4500;
+      break;
+    case Fireworks:
+      for (int k = 0; k < 5; k++) {
+        addParticle(40 + k * 60, 235, static_cast<int>(rnd() % 60) - 30,
+                    -420 - static_cast<int>(rnd() % 120), 0xFFFF, 255,
+                    Firework);
+      }
+      break;
+    case Crash:
+      World::explode(cx, cy, 12);
+      World::blob(cx, cy, 5, Lava, 200, true);
+      shake(900);
+      flash(0xFF8030, 300);
+      break;
+    default:
+      break;
+  }
+  f.active = false;
+}
+
+void updateFalling() {
+  for (int k = 0; k < k_maxFalling; k++) {
+    Falling& f = s_falling[k];
+    if (!f.active) {
+      continue;
+    }
+    f.vy = f.vy + 0.09f > 1.6f ? 1.6f : f.vy + 0.09f;
+    float ny = f.y + f.vy;
+    int iy = static_cast<int>(ny);
+    if (f.effect == Vanish && iy + f.h / 2 > 40) {
+      toast("404 : r\xC3\xA9sultat introuvable. Il s'est \xC3\xA9vapor\xC3\xA9.",
+            2600);
+      land(f);
+      continue;
+    }
+    bool hit = iy + f.h >= H;
+    for (int y = 0; y < f.h && !hit; y++) {
+      for (int x = 0; x < f.w; x++) {
+        if (!fallingBit(f, x, y)) {
+          continue;
+        }
+        int wy = iy + y;
+        if (wy < 0) {
+          continue;
+        }
+        Mat m = World::at(f.x + x, wy);
+        if (m == Air || m == Smoke || m == Fire || m == Statue) {
+          continue;
+        }
+        /* Above the statues, only solid matter stops it (grains resting on
+         * a statue would leave it hanging in the sky) */
+        if (wy < 92 && m != Stone && m != Wood && m != Ice && m != Plant) {
+          continue;
+        }
+        hit = true;
+        break;
+      }
+    }
+    if (hit) {
+      land(f);
+    } else {
+      f.y = ny;
+    }
+  }
+}
+
+void drawFalling(Band& b) {
+  Rect area = b.area();
+  for (int k = 0; k < k_maxFalling; k++) {
+    const Falling& f = s_falling[k];
+    if (!f.active) {
+      continue;
+    }
+    int y0 = static_cast<int>(f.y);
+    for (int y = 0; y < f.h; y++) {
+      int py = (y0 + y) * k_cell;
+      if (py + k_cell <= area.y || py >= area.bottom()) {
+        continue;
+      }
+      for (int x = 0; x < f.w; x++) {
+        if (fallingBit(f, x, y)) {
+          uint32_t hh = hash((x * 31 + y) * 17 + k);
+          KDColor c = World::sample(f.mat);
+          if (hh & 1) {
+            c = mix(c, KDColor::RGB24(0xFFFFFF), 40);
+          }
+          fill(b, {(f.x + x) * k_cell, py, k_cell, k_cell}, c);
+        }
+      }
+    }
+  }
+}
+
+struct Verdict {
+  Mat mat;
+  Effect effect;
+  const char* text;
+};
+
+Verdict judge(const char* input, const char* output) {
+  double v = 0;
+  bool number = parseNumber(output, &v);
+  if (!number) {
+    if (contains(output, "undef") || contains(output, "nonreal") ||
+        contains(output, "\xE2\x88\x9E")) {
+      return {Powder, Boom,
+              "R\xC3\xA9sultat ind\xC3\xA9\x66ini. Le sable a explos\xC3\xA9."};
+    }
+    return {Sand, NoEffect, "Un r\xC3\xA9sultat bizarre tombe du ciel."};
+  }
+  if (input && (strcmp(input, "1+1") == 0 || strcmp(input, "1 + 1") == 0)) {
+    return {Sand, Tiny, "1+1. Pour \xC3\xA7\x61, un seul grain suffit."};
+  }
+  double a = v < 0 ? -v : v;
+  bool integer = a < 1e12 && floor(a) == a;
+  long n = integer ? static_cast<long>(v) : 0;
+  if (integer && n == 42) {
+    return {Gold, NoEffect, "42 : la r\xC3\xA9ponse \xC3\xA0 tout. En or massif."};
+  }
+  if (integer && n == 666) {
+    return {Lava, NoEffect, "666. Calcul d\xC3\xA9moniaque : le ciel crache de la lave."};
+  }
+  if (integer && n == 1337) {
+    return {Virus, NoEffect, "1337. Le d\xC3\xA9sert est pirat\xC3\xA9."};
+  }
+  if (integer && n == 404) {
+    return {Sand, Vanish, ""};
+  }
+  if (integer && (n == 2026 || n == 2027)) {
+    return {Gold, Fireworks, "Bonne ann\xC3\xA9\x65 ! (en avance ou en retard)"};
+  }
+  if (integer && n == 0) {
+    return {Stone, Hole, "Z\xC3\xA9ro. Le n\xC3\xA9\x61nt s'ouvre et aspire tout."};
+  }
+  if (integer && n == 69) {
+    return {Plant, NoEffect, "Nice. Le d\xC3\xA9sert fleurit."};
+  }
+  if (a > 3.14159 && a < 3.1416) {
+    return {Gold, NoEffect, "\xCF\x80 tombe du ciel. Il ne s'arr\xC3\xAAte jamais."};
+  }
+  if (a >= 1e6) {
+    return {Stone, Crash, "Trop grand pour le d\xC3\xA9sert : m\xC3\xA9t\xC3\xA9orite !"};
+  }
+  if (v < 0) {
+    return {Ice, NoEffect, "En dessous de z\xC3\xA9ro : \xC3\xA7\x61 g\xC3\xA8le."};
+  }
+  if (!integer) {
+    return {Water, NoEffect, "Un nombre \xC3\xA0 virgule : \xC3\xA7\x61 coule."};
+  }
+  if (isPrime(n)) {
+    return {Stone, NoEffect, "Nombre premier : incassable. Il reste debout."};
+  }
+  long r = static_cast<long>(sqrt(static_cast<double>(n)) + 0.5);
+  if (n > 3 && r * r == n) {
+    return {Wood, NoEffect, "Carr\xC3\xA9 parfait : en bois massif. Attention au feu."};
+  }
+  return {Sand, NoEffect, "Tes calculs tombent du ciel."};
+}
+
+void serveFood() {
+  uint32_t produced = Food::produced();
+  if (produced == s.foodSeen) {
+    return;
+  }
+  uint32_t first = produced - s.foodSeen > 3 ? produced - 3 : s.foodSeen;
+  int column = 40;
+  const char* lastText = nullptr;
+  for (uint32_t k = first; k < produced; k++) {
+    const Food::Entry* e = Food::at(k);
+    if (!e) {
+      continue;
+    }
+    Verdict v = judge(e->input, e->output);
+    char shown[24];
+    Str t(shown, sizeof(shown));
+    t.add(e->output);
+    if (v.effect == Tiny) {
+      int x = 70 + static_cast<int>(rnd() % 20);
+      World::set(x, 2, Sand);
+    } else {
+      spawnFalling(shown, v.mat, v.effect, column);
+    }
+    column += 42;
+    if (v.text[0]) {
+      lastText = v.text;
+    }
+  }
+  s.foodSeen = produced;
+  if (lastText) {
+    toast(lastText, 3200);
+  }
+}
