+    text(b, t, 160, 104, KDColor::RGB24(k_ink), Small, Align::Center);
+    text(b, "La vraie calculatrice est sous le sable.", 160, 122,
+         KDColor::RGB24(k_ink), Small, Align::Center);
+    text(b, "OK : retour au désert", 160, 146, KDColor::RGB24(k_dim), Small,
+         Align::Center);
+  }
+}
+
+bool menteuseEvent(Event e) {
+  if (s_liar.revealed) {
+    if (e == Events::OK || e == Events::EXE || e == Events::Back ||
+        e == Events::Home) {
+      back();
+    }
+    return true;
+  }
+  if (e == Events::Home) {
+    back();
+    return true;
+  }
+  if (e == Events::Back) {
+    // Back does not work. Unless you press it 3 times quickly.
+    s_liar.backTimes[s_liar.backs % 3] = now();
+    s_liar.backs++;
+    if (s_liar.backs >= 3 &&
+        now() - s_liar.backTimes[(s_liar.backs - 3) % 3] < 2000) {
+      s_liar.revealed = true;
+      s_liar.revealStart = now();
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    liarCompute();
+    return true;
+  }
+  if (e == Events::Backspace) {
+    if (s_liar.len > 0) {
+      s_liar.input[--s_liar.len] = 0;
+    }
+    return true;
+  }
+  if (e == Events::Clear) {
+    s_liar.len = 0;
+    s_liar.input[0] = 0;
+    return true;
+  }
+  char c = 0;
+  if (e == Events::Multiplication) {
+    c = '*';
+  } else if (e == Events::Division) {
+    c = '/';
+  } else if (e == Events::Pi) {
+    c = 'p';
+  } else if (e == Events::Sqrt) {
+    c = 'r';
+  } else if (e == Events::Square) {
+    if (s_liar.len < 36) {
+      s_liar.input[s_liar.len++] = '^';
+      s_liar.input[s_liar.len++] = '2';
+      s_liar.input[s_liar.len] = 0;
+    }
+    return true;
+  } else if (e == Events::Power) {
+    c = '^';
+  } else {
+    const char* t = e.text();
+    if (t && t[0] && !t[1] &&
+        ((t[0] >= '0' && t[0] <= '9') || t[0] == '.' || t[0] == '+' ||
+         t[0] == '-' || t[0] == '(' || t[0] == ')')) {
+      c = t[0];
+    }
+  }
+  if (c && s_liar.len < 38) {
+    s_liar.input[s_liar.len++] = c;
+    s_liar.input[s_liar.len] = 0;
+  }
+  return true;
+}
