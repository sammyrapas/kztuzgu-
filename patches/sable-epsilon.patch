+/* ========================================================= MENTEUSE */
+
+// Recursive descent over the internal ASCII expression
+struct Parser {
+  const char* p;
+  bool error;
+  double expr();
+  double term();
+  double power();
+  double unary();
+  double primary();
+  bool startsFactor() const {
+    return (*p >= '0' && *p <= '9') || *p == '.' || *p == '(' || *p == 'p' ||
+           *p == 'r';
+  }
+};
+
+double Parser::expr() {
+  double v = term();
+  while (*p == '+' || *p == '-') {
+    char op = *p++;
+    double w = term();
+    v = op == '+' ? v + w : v - w;
+  }
+  return v;
+}
+
+double Parser::term() {
+  double v = power();
+  while (*p == '*' || *p == '/' || startsFactor()) {
+    char op = (*p == '*' || *p == '/') ? *p++ : '*';
+    double w = power();
+    v = op == '*' ? v * w : v / w;
+  }
+  return v;
+}
+
+double Parser::power() {
+  double v = unary();
+  if (*p == '^') {
+    p++;
+    double w = power();
+    return pow(v, w);
+  }
+  return v;
+}
+
+double Parser::unary() {
+  if (*p == '-') {
+    p++;
+    return -unary();
+  }
+  return primary();
+}
+
+double Parser::primary() {
+  if (*p == '(') {
+    p++;
+    double v = expr();
+    if (*p == ')') {
+      p++;
+    }
+    return v;
+  }
+  if (*p == 'p') {
+    p++;
+    return M_PI;
+  }
+  if (*p == 'r') {
+    p++;
+    double v = expr();
+    if (*p == ')') {
+      p++;
+    }
+    return sqrt(v);
+  }
+  if ((*p >= '0' && *p <= '9') || *p == '.') {
+    double v = 0;
+    while (*p >= '0' && *p <= '9') {
+      v = v * 10 + (*p++ - '0');
+    }
+    if (*p == '.') {
+      p++;
+      double f = 0.1;
+      while (*p >= '0' && *p <= '9') {
+        v += (*p++ - '0') * f;
+        f /= 10;
+      }
+    }
+    return v;
+  }
+  error = true;
+  return 0;
+}
+
+void displayExpression(const char* in, Str& out) {
+  for (const char* p = in; *p; p++) {
+    switch (*p) {
+      case '*':
+        out.add("×");
+        break;
+      case '/':
+        out.add("÷");
+        break;
+      case 'p':
+        out.add("π");
+        break;
+      case 'r':
+        out.add("√(");
+        break;
+      default: {
+        char c[2] = {*p, 0};
+        out.add(c);
+      }
+    }
+  }
+}
