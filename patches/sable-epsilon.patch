+}
+
+void holdKey(Key k, bool down) {
+  uint64_t bit = static_cast<uint64_t>(1) << static_cast<int>(k);
+  s_fakeKeys = down ? (s_fakeKeys | bit) : (s_fakeKeys & ~bit);
+}
