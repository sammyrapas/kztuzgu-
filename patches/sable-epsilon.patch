+constexpr int k_hx = 96;  // center of the hourglass
+
+float sablierFraction() {
+  if (!s.sablierOn || s.sablierDuration == 0) {
+    return 1;
+  }
+  uint32_t e = now() - s.sablierStart;
+  if (e >= s.sablierDuration) {
+    return 0;
+  }
+  return 1 - static_cast<float>(e) / s.sablierDuration;
+}
+
+float s_topLevel = 1, s_bottomLevel = 0;
+
+int topSand(int dx, int y) {
+  // y relative to the neck (112), going up; half width of the bulb
+  int dy = 112 - y;
+  if (dy < 0 || dy > 78) {
+    return 0;
+  }
+  int half = 4 + dy * 58 / 78;
+  if (dx < -half || dx > half) {
+    return 0;
+  }
+  float h = 78 * sqrtf(s_topLevel);
+  return dy <= h ? 1 : 0;
+}
+
+int bottomSand(int dx, int y) {
+  int dy = y - 128;
+  if (dy < 0 || dy > 78) {
+    return 0;
+  }
+  int half = 4 + dy * 58 / 78;
+  if (dx < -half || dx > half) {
+    return 0;
+  }
+  float h = 72 * sqrtf(s_bottomLevel);
+  int adx = dx < 0 ? -dx : dx;
+  return y >= 206 - h + adx * 0.45f ? 1 : 0;
+}
+
+int topInside(int x, int y) { return topSand(x - k_hx, y); }
+int bottomInside(int x, int y) { return bottomSand(x - k_hx, y); }
+
+void drawHourglass(Band& b, float fraction, bool running) {
+  s_topLevel = fraction;
+  s_bottomLevel = 1 - fraction;
+  KDColor wood = KDColor::RGB24(0x7A4A22);
+  roundFill(b, {k_hx - 70, 24, 140, 10}, 4, wood);
+  roundFill(b, {k_hx - 70, 206, 140, 10}, 4, wood);
+  for (int k = 0; k < 2; k++) {
+    fill(b, {k_hx - 66 + k * 128, 34, 4, 172}, KDColor::RGB24(0x5A3418));
+  }
+  // glass
+  KDColor glass = KDColor::RGB24(0xBFD8F0);
+  line(b, k_hx - 62, 34, k_hx - 4, 112, 1.5f, glass, 160);
+  line(b, k_hx + 62, 34, k_hx + 4, 112, 1.5f, glass, 160);
+  line(b, k_hx - 4, 128, k_hx - 62, 206, 1.5f, glass, 160);
+  line(b, k_hx + 4, 128, k_hx + 62, 206, 1.5f, glass, 160);
+  fill(b, {k_hx - 4, 112, 1, 16}, glass, 160);
+  fill(b, {k_hx + 4, 112, 1, 16}, glass, 160);
+  sandTexture(b, {k_hx - 64, 34, 128, 80}, 0, 0, topInside);
+  sandTexture(b, {k_hx - 64, 128, 128, 80}, 0, 0, bottomInside);
+  if (running && fraction > 0) {
+    // the thin stream through the neck
+    float h = 72 * sqrtf(s_bottomLevel);
+    int bottom = static_cast<int>(206 - h);
+    for (int y = 112; y < bottom; y += 2) {
+      if (hash(y * 31 + now() / 40) & 1) {
+        fill(b, {k_hx - 1 + static_cast<int>(hash(y + now()) % 2), y, 2, 2},
+             KDColor::RGB24(k_sand));
+      }
+    }
+  }
+  // reflection on the glass
+  line(b, k_hx - 44, 44, k_hx - 20, 80, 2, KDColor::RGB24(0xFFFFFF), 60);
+}
