+void setLed(KDColor c) {
+  if (!s.ledSet || static_cast<uint16_t>(c) != s.ledLast) {
+    if (!s_fake) {
+      Ion::LED::setColor(c);
+    }
+    s.ledLast = static_cast<uint16_t>(c);
+    s.ledSet = true;
+  }
+}
+
+void restoreLed() {
+  if (s.ledSet) {
+    if (!s_fake) {
+      Ion::LED::updateColorWithPlugAndCharge();
+    }
+    s.ledSet = false;
+  }
+}
+
+void updateLed() {
+  if (!s.ledOn || examMode() || !s_attached) {
+    restoreLed();
+    return;
+  }
+  KDColor c = KDBlack;
+  int k = 0;
+  if (s.now < s.flashUntil) {
+    c = KDColor::RGB24(s.flashColor);
+    k = 255;
+  } else if (s.mode >= Mode::Sablier) {
+    c = KDColor::RGB16(Labo::ledColor(&k));
+  } else if (s.now < s.boltUntil) {
+    c = KDColor::RGB24(0xFFFFFF);
+    k = 255;
+  } else if (World::burning() > 30) {
+    c = KDColor::RGB24(0xFF5010);
+    int b = static_cast<int>(World::burning());
+    k = (b > 400 ? 120 : 30 + b / 5) + static_cast<int>(hash(s.now / 70) % 50);
+  } else if (World::virusCount() > 30) {
+    c = KDColor::RGB24(0x40FF30);
+    k = 50 + static_cast<int>(40 * sinf(s.now / 250.f));
+  } else if (s.now < s.holeUntil) {
+    c = KDColor::RGB24(0x8020FF);
+    k = 120;
+  }
+  if (k <= 0) {
+    restoreLed();
+    return;
+  }
+  k = k > 255 ? 255 : k;
+  setLed(KDColor::RGB888(c.red() * k / 255, c.green() * k / 255,
+                         c.blue() * k / 255));
+}
+
+void updateBacklight() {
+  int target = s.userBrightness < 8 ? 8 : s.userBrightness;
+  if (target != s.brightness) {
+    s.brightness = target;
+    if (!s_fake) {
+      Ion::Backlight::setBrightness(target);
+    }
+  }
+}
+
+void brightness(int dir) {
+  constexpr int k_step = Ion::Backlight::MaxBrightness /
+                         GlobalPreferences::NumberOfBrightnessStates;
+  int v = clampi(s.userBrightness + dir * k_step, k_step,
+                 Ion::Backlight::MaxBrightness);
+  s.userBrightness = v;
+  if (!s_fake) {
+    GlobalPreferences::SharedGlobalPreferences()->setBrightnessLevel(v);
+  }
+  char t[64];
+  Str m(t, sizeof(t));
+  m.add("Lune : ");
+  int bars = v * 8 / Ion::Backlight::MaxBrightness;
+  for (int i = 0; i < 8; i++) {
+    m.add(i < bars ? "|" : ".");
+  }
+  toast(t, 1400);
+}
