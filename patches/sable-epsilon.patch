+void nightBackground(Band& b) {
+  Rect area = b.area();
+  for (int y = area.y; y < area.bottom(); y++) {
+    KDColor c = mix(KDColor::RGB24(k_night), KDColor::RGB24(0x2E1838),
+                    y * 256 / 240);
+    KDColor* row = b.row(y);
+    for (int x = 0; x < 320; x++) {
+      row[x] = c;
+    }
+    for (int x = 0; x < 320; x += 2) {
+      uint32_t h = hash(x * 911 + y * 3);
+      if ((h & 1023) == 0) {
+        int tw = static_cast<int>((h >> 10) + now() / 300) & 7;
+        row[x] = tw < 5 ? KDColor::RGB24(0xDCDCFF) : KDColor::RGB24(0x5A5A8C);
+      }
+    }
+  }
+}
