+bool sablierEvent(Event e) {
+  if (!s.sablierOn) {
+    if (s.sablierPick <= 0) {
+      s.sablierPick = 55;
+    }
+    if (e == Events::Up) {
+      s.sablierPick = clampi(s.sablierPick + 5, 1, 240);
+    } else if (e == Events::Down) {
+      s.sablierPick = clampi(s.sablierPick - 5, 1, 240);
+    } else if (e == Events::Right) {
+      s.sablierPick = clampi(s.sablierPick + 1, 1, 240);
+    } else if (e == Events::Left) {
+      s.sablierPick = clampi(s.sablierPick - 1, 1, 240);
+    } else if (e == Events::OK || e == Events::EXE) {
+      s.sablierOn = true;
+      s.sablierRang = false;
+      s.sablierStart = now();
+      s.sablierDuration = static_cast<uint32_t>(s.sablierPick) * 60000;
+      shake(250);
+    } else if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+      back();
+    }
+    return true;
+  }
+  if (s.sablierRang) {
+    if (e == Events::OK || e == Events::EXE || e == Events::Back ||
+        e == Events::Home) {
+      s.sablierOn = false;
+      s.sablierRang = false;
+      back();
+    }
+    return true;
+  }
+  if (e == Events::Backspace) {
+    s.sablierOn = false;
+    toast("Sablier arrêté. Le temps est à nouveau infini.", 2000);
+    return true;
+  }
+  if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+    back();
+  }
+  return true;
+}
