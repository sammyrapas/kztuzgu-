+/* ========================================================= launching */
+
+void renderCurtain(Band& b, float k) {
+  // Sand pours over the screen from the top
+  Rect area = b.area();
+  for (int y = area.y; y < area.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = 0; x < k_screenWidth; x += 2) {
+      uint32_t h = hash(x * 7919 + 3);
+      float limit = k * 300 - (h % 90);
+      if (y < limit) {
+        KDColor c = KDColor::RGB24(k_sand);
+        uint32_t g = hash(x * 31 + y * 7);
+        if (g & 1) {
+          c = mix(c, KDColor::RGB24(0x9A6A30), 60 + (g >> 4) % 60);
+        }
+        row[x] = c;
+        row[x + 1] = c;
+      }
+    }
+  }
+}
+
+float s_curtain = 0;
+
+void launchApp(int index) {
+  s.lastLaunched = index;
+  s.launches++;
+  s_launch = s_apps[index].item;
+}
+
+void blowAndLaunch(int index) {
+  if (s_apps[index].item.kind == Item::Kind::External && examMode()) {
+    toast("Mode examen : les jeux sont ensabl\xC3\xA9s.", 2500);
+    return;
+  }
+  s.building = false;
+  blowStatues(s.selected, 70, 30);
+  s.snaps++;
+  uint32_t start = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    uint32_t t = s.now - start;
+    if (t > 900) {
+      break;
+    }
+    World::step(s.now);
+    updateParticles();
+    s_curtain = t > 560 ? (t - 560) / 300.f : 0;
+    updateLed();
+    renderFull(band);
+  }
+  s_curtain = 0;
+  launchApp(index);
+}
+
+void panic() {
+  s.panics++;
+  if (s_calculationIndex < 0) {
+    return;
+  }
+  // Everything collapses at once
+  s.building = false;
+  blowStatues(-1, 30, 70);
+  uint32_t start = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    uint32_t t = s.now - start;
+    if (t > 380) {
+      break;
+    }
+    World::step(s.now);
+    updateParticles();
+    s_curtain = t / 330.f;
+    renderFull(band);
+  }
+  s_curtain = 0;
+  s.lastLaunched = -2;
+  s_launch = s_apps[s_calculationIndex].item;
+}
