+namespace {
+
+void prepareLogo() {
+  uint8_t mask[50 * 18];
+  int w = 0, h = 0;
+  textMask("SABLE", Large, mask, 50, 18, &w, &h);
+  memset(s_logo, 0, sizeof(s_logo));
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      if (mask[y * 50 + x]) {
+        int b = y * w + x;
+        s_logo[b >> 3] |= 1 << (b & 7);
+      }
+    }
+  }
+  s_logoW = w;
+  s_logoH = h;
+}
+
+void crumbleLogo() {
+  int scale = 2;
+  int lw = s_logoW * scale, lh = s_logoH * scale;
+  int x0 = (W - lw) / 2, y0 = 26;
+  for (int cy = y0; cy < y0 + lh; cy++) {
+    for (int cx = x0; cx < x0 + lw; cx++) {
+      int bit = ((cy - y0) / scale) * s_logoW + (cx - x0) / scale;
+      if (logoBit(bit)) {
+        World::set(cx, cy, Sand);
+      }
+    }
+  }
+}
+
+/* The screen as the app left it, 2 x 2 pixels per cell */
+void captureScreen() {
+  KDColor rows[2 * k_screenWidth];
+  for (int cy = 0; cy < H; cy++) {
+    Ion::Display::pullRect(KDRect(0, cy * 2, k_screenWidth, 2), rows);
+    for (int cx = 0; cx < W; cx++) {
+      KDColor a = rows[cx * 2], b = rows[cx * 2 + 1],
+              c = rows[k_screenWidth + cx * 2],
+              d = rows[k_screenWidth + cx * 2 + 1];
+      int r = (a.red() + b.red() + c.red() + d.red()) / 4;
+      int g = (a.green() + b.green() + c.green() + d.green()) / 4;
+      int bl = (a.blue() + b.blue() + c.blue() + d.blue()) / 4;
+      g_colors[cy * W + cx] = KDColor::RGB888(r, g, bl);
+    }
+  }
+}
