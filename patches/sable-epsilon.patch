+Item Shell::takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+int Shell::framePeriod() { return 30; }
+
+bool Shell::frame() {
+  if (!s_attached) {
+    return false;
+  }
+  s.now = clockMs();
+  s.last = s.now;
+  if (s.mode == Mode::Boot) {
+    uint32_t t = s.now - s.modeStart;
+    if (t < 1500 && (t / 30) % 2 == 0) {
+      // sand pouring into the letters
+      int lw = s_logoW * 2;
+      int x0 = (W - lw) / 2;
+      addParticle((x0 + static_cast<int>(rnd() % lw)) * k_cell, -4, 0, 200,
+                  static_cast<uint16_t>(KDColor::RGB24(k_sand)), 70, Spark);
+    }
+    if (t > 2300 && s_logoW != 0) {
+      crumbleLogo();
+      s_logoW = 0;
+      shake(300);
+    }
+    if (t > k_bootDuration) {
+      startHome();
+      toast("OK : ouvrir \xC2\xB7 Var : mode Dieu \xC2\xB7 Bo\xC3\xAEte \xC3\xA0 "
+            "outils : le Labo\nsin cos tan ln log x^2 \xE2\x88\x9A \xCF\x80 ^ "
+            ": catastrophes \xC2\xB7 Effacer : PANIQUE",
+            5200);
+    }
+  }
+  if (s.returning && !World::isFreezing(s.now)) {
+    s.returning = false;
+    startBuild();
+    if (s.lastLaunched == -2) {
+      toast("Il est parti ? Le sable n'a rien vu.", 2600);
+    }
+    serveFood();
+  }
+  if (s.mode >= Mode::Sablier) {
+    Labo::update();
+  } else {
+    World::step(s.now);
+    updateBuild();
+    updateDisasters();
+    updateFalling();
+    if (s.mode == Mode::God) {
+      Ion::Keyboard::State keys = scanKeys();
+      if (keys.keyDown(Key::OK) || keys.keyDown(Key::EXE)) {
+        World::blob(s.curX, s.curY, s.brushSize, static_cast<Mat>(s.brush),
+                    s.brush == Air ? 256 : 150, s.brush == Air);
+      }
+      if (keys.keyDown(Key::Backspace)) {
+        World::blob(s.curX, s.curY, s.brushSize, Air, 256, true);
+      }
+    }
+  }
+  updateParticles();
+  Labo::updateSablier();
+  updateLed();
+  updateBacklight();
+  return true;
+}
+
+bool Shell::handleEvent(Event e) {
+  if (!s_attached) {
+    return false;
+  }
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  s.now = clockMs();
+  if (s.mode == Mode::Boot) {
+    if (s.now - s.modeStart > 300) {
+      if (s_logoW != 0) {
+        crumbleLogo();
+        s_logoW = 0;
+      }
+      startHome();
+    }
+    return true;
+  }
+  if (s.mode >= Mode::Sablier) {
+    return Labo::handleEvent(e);
+  }
+  if (s.mode == Mode::Labo) {
+    return Labo::handleMenu(e);
+  }
+  if ((e == Events::Plus || e == Events::Minus) && s.mode != Mode::God) {
+    brightness(e == Events::Plus ? 1 : -1);
+    return true;
+  }
+  // Disasters work in every desert mode
+  if (s.mode == Mode::Home || s.mode == Mode::God) {
+    if (!(s.mode == Mode::God && e == Events::Zero)) {
+      const char* message = disaster(e);
+      if (message) {
+        s.disasters++;
+        toast(message, 2600);
+        return true;
+      }
+    }
+  }
+  if (s.mode == Mode::God) {
+    if (e == Events::Var || e == Events::Back || e == Events::Home) {
+      setMode(Mode::Home);
+      toast("Mode Dieu : termin\xC3\xA9. Le d\xC3\xA9sert se souviendra.", 1800);
+      return true;
+    }
+    int step = 2;
+    if (e == Events::Left) {
+      s.curX = clampi(s.curX - step, 0, W - 1);
+    } else if (e == Events::Right) {
+      s.curX = clampi(s.curX + step, 0, W - 1);
+    } else if (e == Events::Up) {
+      s.curY = clampi(s.curY - step, 0, H - 1);
+    } else if (e == Events::Down) {
+      s.curY = clampi(s.curY + step, 0, H - 1);
+    } else if (e == Events::Plus) {
+      s.brushSize = clampi(s.brushSize + 1, 0, 8);
+    } else if (e == Events::Minus) {
+      s.brushSize = clampi(s.brushSize - 1, 0, 8);
+    } else if (e == Events::OK || e == Events::EXE) {
+      World::blob(s.curX, s.curY, s.brushSize, static_cast<Mat>(s.brush),
+                  s.brush == Air ? 256 : 200, s.brush == Air);
+    } else if (e == Events::Backspace) {
+      World::blob(s.curX, s.curY, s.brushSize, Air, 256, true);
+    } else if (e == Events::Toolbox) {
+      Labo::open(Mode::Labo);
+    } else {
+      static constexpr Mat k_keys[12] = {Sand, Water,  Lava,  Fire,
+                                         Stone, Wood,  Plant, Ice,
+                                         Acid,  Powder, Virus, Gold};
+      Event k_events[12] = {Events::One,   Events::Two,  Events::Three,
+                            Events::Four,  Events::Five, Events::Six,
+                            Events::Seven, Events::Eight, Events::Nine,
+                            Events::Zero,  Events::Dot,  Events::EE};
+      for (int k = 0; k < 12; k++) {
+        if (e == k_events[k]) {
+          s.brush = k_keys[k];
+          toast(World::name(k_keys[k]), 700);
+          return true;
+        }
+      }
+      return true;
+    }
+    return true;
+  }
+  // Home
+  if (e == Events::Backspace) {
+    panic();
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    move(e == Events::Left ? -1 : (e == Events::Right ? 1 : 0),
+         e == Events::Up ? -1 : (e == Events::Down ? 1 : 0));
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    int app = appAtSlot(s.page, s.selected);
+    if (app >= 0) {
+      blowAndLaunch(app);
+    }
+    return true;
+  }
+  if (e == Events::Var) {
+    setMode(Mode::God);
+    toast("MODE DIEU. Fl\xC3\xA8\x63hes : viser \xC2\xB7 OK (maintenu) : verser "
+          "\xC2\xB7 1-9 0 . E : mati\xC3\xA8re \xC2\xB7 Var : quitter",
+          3800);
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    Labo::open(Mode::Labo);
+    return true;
+  }
+  if (e == Events::Back || e == Events::Home) {
+    if (s.page != 0) {
+      changePage(0, 0);
+    } else {
+      select(0);
+    }
+    return true;
+  }
+  const char* t = e.text();
+  if (t && t[0] >= '1' && t[0] <= '9' && t[1] == 0) {
+    int page = t[0] - '1';
+    if (page < s.numberOfPages) {
+      changePage(page, 0);
+    }
+    return true;
+  }
+  return false;
+}
+
+/* ======================================================== photo session */
+
+#if !PLATFORM_DEVICE
+namespace {
+KDColor s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    Shell::render(band);
+    memcpy(s_shot + y * k_screenWidth, band.pixels(),
+           sizeof(KDColor) * k_screenWidth * Band::k_maxHeight);
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("SABLE_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void step(int ms, const char* gif = nullptr, int every = 1) {
+  int n = 0;
