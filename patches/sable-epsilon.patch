+
+void wrapText(Band& b, const char* t, int x, int y, int columns, KDColor c,
+              Align align, int* height) {
+  int lines = 0;
+  const char* p = t;
+  while (*p && lines < 4) {
+    const char* start = p;
+    const char* lastSpace = nullptr;
+    int glyphs = 0;
+    const char* q = p;
+    while (*q) {
+      if (*q == ' ') {
+        lastSpace = q;
+      }
+      if ((static_cast<uint8_t>(*q) & 0xC0) != 0x80) {
+        glyphs++;
+      }
+      if (glyphs > columns) {
+        break;
+      }
+      q++;
+    }
+    const char* end = (*q && lastSpace) ? lastSpace : q;
+    char line[96];
+    int n = static_cast<int>(end - start) < 95 ? static_cast<int>(end - start)
+                                                : 95;
+    memcpy(line, start, n);
+    line[n] = 0;
+    text(b, line, x, y + lines * 15, c, Small, align);
+    lines++;
+    p = *end == ' ' ? end + 1 : end;
+  }
+  *height = lines * 15;
+}
