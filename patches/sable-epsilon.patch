+namespace {
+
+void spawnTop(Mat m, int n, int x0 = 0, int x1 = W) {
+  for (int k = 0; k < n; k++) {
+    int x = x0 + static_cast<int>(rnd() % (x1 - x0));
+    int g = World::gravity();
+    int cx = x, cy = 0;
+    if (g == 2) {
+      cy = H - 1;
+    } else if (g == 1) {
+      cx = 0;
+      cy = static_cast<int>(rnd() % H);
+    } else if (g == 3) {
+      cx = W - 1;
+      cy = static_cast<int>(rnd() % H);
+    }
+    if (World::at(cx, cy) == Air) {
+      World::set(cx, cy, m);
+    }
+  }
+}
+
+void lightning() {
+  int x = 10 + static_cast<int>(rnd() % (W - 20));
+  int y = 0;
+  s.boltN = 0;
+  while (y < H && s.boltN < 40) {
+    s.boltX[s.boltN] = static_cast<int8_t>(x / 2);
+    s.boltY[s.boltN] = static_cast<int8_t>(y / 2);
+    s.boltN++;
+    Mat m = World::at(x, y);
+    if (m != Air && m != Smoke) {
+      break;
+    }
+    y += 3 + static_cast<int>(rnd() % 4);
+    x += static_cast<int>(rnd() % 7) - 3;
+    x = clampi(x, 0, W - 1);
+  }
+  y = y >= H ? H - 1 : y;
+  World::explode(x, y, 4);
+  World::blob(x, y, 3, Fire, 200, false);
+  s.boltUntil = s.now + 260;
+  flash(0xFFFFFF, 120);
+  shake(300);
+}
+
+const char* disaster(Event e) {
+  uint32_t now = s.now;
+  if (e == Events::Sine) {
+    s.rainUntil = now + 5000;
+    return "sin : la pluie. Le d\xC3\xA9sert n'en revient pas.";
+  }
+  if (e == Events::Cosine) {
+    s.stormUntil = now + 4000;
+    return "cos : temp\xC3\xAAte de sable !";
+  }
+  if (e == Events::Tangent) {
+    for (int y = H / 3; y < H; y++) {
+      for (int x = 0; x < 14; x++) {
+        if (World::at(x, y) == Air) {
+          World::set(x, y, Water);
+        }
+      }
+    }
+    s.tsunamiUntil = now + 2500;
+    return "tan : TSUNAMI. Tout le monde sur les statues.";
+  }
+  if (e == Events::Square) {
+    lightning();
+    return "x^2 : la foudre est tomb\xC3\xA9\x65 au carr\xC3\xA9.";
+  }
+  if (e == Events::Ln) {
+    s.volcanoUntil = now + 4500;
+    return "ln : le volcan se r\xC3\xA9veille.";
+  }
+  if (e == Events::Log) {
+    for (int k = 0; k < 4; k++) {
+      World::set(20 + static_cast<int>(rnd() % 120), 1, Virus);
+    }
+    return "log : un virus se propage. Le feu le soigne.";
+  }
+  if (e == Events::Exp) {
+    World::explode(W / 2, H / 2, 20);
+    burst(160, 120, 70, -1);
+    shake(1100);
+    flash(0xFFFFFF, 300);
+    return "e^x : croissance exponentielle de l'explosion.";
+  }
+  if (e == Events::Pi) {
+    spawnFalling("3.14159", Gold, NoEffect, 50);
+    spawnFalling("265358", Gold, NoEffect, 110);
+    return "\xCF\x80 : il pleut des d\xC3\xA9\x63imales. En or.";
+  }
+  if (e == Events::Sqrt) {
+    // between two statues
+    static constexpr int k_gaps[4] = {5, 53, 107, 154};
+    s.stalkX = k_gaps[rnd() % 4];
+    int y = H - 1;
+    while (y > 0 && World::at(s.stalkX, y) != Air) {
+      y--;
+    }
+    s.stalkY = y;
+    s.stalkLeft = 100;
+    return "\xE2\x88\x9A : une racine pousse. Une tr\xC3\xA8s grande racine.";
+  }
+  if (e == Events::Power) {
+    addParticle(330, -10, -150, 60, KDColor::RGB888(255, 120, 40), 255,
+                Meteor);
+    return "^ : m\xC3\xA9t\xC3\xA9orite en approche !";
+  }
+  if (e == Events::EE) {
+    s.goldUntil = now + 3000;
+    return "\xC3\x97\x31\x30^x : JACKPOT. Il pleut de l'or.";
+  }
+  if (e == Events::Imaginary) {
+    s.psycheUntil = now + 6000;
+    return "i : bienvenue dans le monde imaginaire.";
+  }
+  if (e == Events::XNT) {
+    s.quakeUntil = now + 1600;
+    shake(1600);
+    return "x,n,t : s\xC3\xA9isme de magnitude x.";
+  }
+  if (e == Events::Ans) {
+    int n = World::snapHalf([](int x, int y, uint16_t color, Mat m) {
+      if ((rnd() & 3) == 0) {
+        addParticle(x * k_cell, y * k_cell, static_cast<int>(rnd() % 60) - 10,
+                    -static_cast<int>(rnd() % 40),
+                    m == Statue || m == Dust
+                        ? color
+                        : static_cast<uint16_t>(World::sample(m)),
+                    160 + (rnd() & 63), Drift);
+      }
+    });
+    s.vaporized += n;
+    flash(0xFFE0A0, 120);
+    return "*clac* La moiti\xC3\xA9 de la mati\xC3\xA8re a disparu. \xC3\x89quilibre parfait.";
+  }
+  if (e == Events::LeftParenthesis || e == Events::RightParenthesis) {
+    int g = (World::gravity() + (e == Events::LeftParenthesis ? 1 : 3)) % 4;
+    World::setGravity(g);
+    static const char* const k_dirs[4] = {
+        "Gravit\xC3\xA9 : vers le bas. Tout est normal.",
+        "Calculatrice tourn\xC3\xA9\x65 : la gravit\xC3\xA9 va \xC3\xA0 droite.",
+        "Calculatrice \xC3\xA0 l'envers. Tout tombe vers le ciel.",
+        "Calculatrice tourn\xC3\xA9\x65 : la gravit\xC3\xA9 va \xC3\xA0 gauche."};
+    return k_dirs[g];
+  }
+  if (e == Events::Zero) {
+    s.floorUntil = now + 2600;
+    return "0 : on vide le d\xC3\xA9sert. GLOUGLOUGLOU.";
+  }
+  return nullptr;
+}
+
+void updateDisasters() {
+  uint32_t now = s.now;
+  if (now < s.rainUntil) {
+    spawnTop(Water, 6);
+  }
+  if (now < s.stormUntil) {
+    spawnTop(Sand, 5, 0, W / 2);
+    World::wind(1, 700);
+  }
+  if (now < s.tsunamiUntil) {
+    World::wind(1, 1200);
+  }
+  if (now < s.goldUntil) {
+    spawnTop(Gold, 3);
+  }
+  if (now < s.quakeUntil) {
+    World::quake(500);
+  }
+  if (now < s.volcanoUntil) {
+    int cx = W / 2 + static_cast<int>(rnd() % 7) - 3;
+    for (int y = H - 1; y > H - 4; y--) {
+      if (World::at(cx, y) != Statue) {
+        World::set(cx, y, Lava);
+      }
+    }
+    if ((rnd() & 1) == 0) {
+      addParticle(160 + static_cast<int>(rnd() % 10) - 5, 232,
+                  static_cast<int>(rnd() % 200) - 100,
+                  -260 - static_cast<int>(rnd() % 220),
+                  KDColor::RGB888(255, 90 + (rnd() & 60), 20), 255, LavaBomb);
+    }
+    shake(60);
+  }
+  World::setPsyche(now < s.psycheUntil);
+  World::openFloor(now < s.floorUntil);
+  if (now < s.holeUntil) {
+    World::blackHole(s.holeX, s.holeY, 26);
+  }
+  if (s.stalkLeft > 0 && s.stalkY > 1) {
+    for (int dx = -1; dx <= 1; dx++) {
+      if (World::at(s.stalkX + dx, s.stalkY) != Statue) {
+        World::set(s.stalkX + dx, s.stalkY, Plant);
+      }
+    }
+    if (s.stalkLeft % 9 == 0) {
+      // a leaf
+      int side = (s.stalkLeft / 9) & 1 ? 1 : -1;
+      for (int l = 2; l < 9; l++) {
+        for (int t = 0; t < 2; t++) {
+          int x = s.stalkX + side * l, y = s.stalkY - l / 3 - t;
+          if (World::at(x, y) == Air) {
+            World::set(x, y, Plant);
+          }
+        }
+      }
+    }
+    if ((s.stalkLeft & 3) == 0) {
+      s.stalkX = clampi(s.stalkX + static_cast<int>(rnd() % 3) - 1, 3, W - 4);
+    }
+    s.stalkY--;
+    s.stalkLeft--;
+    if (s.stalkLeft == 0 || s.stalkY <= 1) {
+      // a flower on top
+      World::blob(s.stalkX, s.stalkY + 1, 3, Gold, 200, false);
+      s.stalkLeft = 0;
+    }
+  }
+  // Explosions shake the screen
+  uint32_t booms = World::booms();
+  if (booms != s.booms) {
+    s.explosions += booms - s.booms;
+    s.booms = booms;
+    shake(450);
+    if (now >= s.flashUntil) {
+      flash(0xFF9030, 90);
+    }
+    burst(World::lastBoomX() * k_cell, World::lastBoomY() * k_cell, 14, -1);
+  }
+  // The desert overflows: the floor opens
+  if (now - s.lastCountTime > 1000) {
+    s.lastCountTime = now;
+    int n = World::count();
+    if (n > 9800 && now >= s.floorUntil && s.mode == Mode::Home) {
+      s.floorUntil = now + 2500;
+      toast("Le d\xC3\xA9sert d\xC3\xA9\x62orde. On tire la chasse.", 2500);
+    } else if (n < 250 && now > s.floorUntil + 1500 &&
+               now >= s.stormUntil && s.mode == Mode::Home &&
+               World::gravity() == 0) {
+      s.stormUntil = now + 3500;
+      toast("Le d\xC3\xA9sert est vide. Le vent ram\xC3\xA8ne du sable.", 2500);
+    }
+    s.lastCount = n;
+  }
+}
