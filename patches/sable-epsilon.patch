+    return;
+  }
+  int t = n / 10, u = n % 10;
+  if (t == 7 || t == 9) {
+    out.add(k_tens[t]);
+    out.add(t == 7 && u == 1 ? " et " : "-");
+    out.add(k_units[10 + u]);
+    return;
+  }
+  out.add(k_tens[t]);
+  if (u == 0) {
+    if (t == 8) {
+      out.add("s");
+    }
+    return;
+  }
+  out.add(u == 1 && t != 8 ? " et " : "-");
+  out.add(k_units[u]);
+}
+
+void french(long n, Str& out) {
+  if (n < 0) {
+    out.add("moins ");
+    n = -n;
+  }
+  if (n >= 1000) {
+    long th = n / 1000;
+    if (th > 1) {
+      french(th, out);
+      out.add(" ");
+    }
+    out.add("mille");
+    n %= 1000;
+    if (n == 0) {
+      return;
+    }
+    out.add(" ");
+  }
+  if (n >= 100) {
+    int h = static_cast<int>(n / 100);
+    if (h > 1) {
+      out.add(k_units[h]).add(" ");
+    }
+    out.add("cent");
+    n %= 100;
+    if (n == 0) {
+      if (h > 1) {
+        out.add("s");
+      }
+      return;
+    }
+    out.add(" ");
+  }
+  frenchUnder100(static_cast<int>(n), out);
+}
+
+void roman(long n, Str& out) {
+  static const int k_values[] = {1000, 900, 500, 400, 100, 90, 50,
+                                 40,   10,  9,   5,   4,   1};
+  static const char* const k_symbols[] = {"M",  "CM", "D",  "CD", "C",
+                                          "XC", "L",  "XL", "X",  "IX",
+                                          "V",  "IV", "I"};
+  for (int k = 0; k < 13; k++) {
+    while (n >= k_values[k]) {
+      out.add(k_symbols[k]);
+      n -= k_values[k];
+    }
+  }
+}
+
+void lie(const char* input, double v, Str& out) {
+  bool finite = v == v && v < 1e300 && v > -1e300;
+  if (!finite) {
+    out.add("Division par 0. J'appelle tes parents.");
+    return;
+  }
+  if (strcmp(input, "1+1") == 0) {
+    out.add("Sérieux ? T'as besoin de moi pour ça ?");
+    return;
+  }
+  if (contains(input, "666")) {
+    out.add("Non. Je ne calcule pas ça.");
+    return;
+  }
+  double a = v < 0 ? -v : v;
+  bool integer = a < 1e9 && floor(a) == a;
+  long n = integer ? static_cast<long>(v) : 0;
+  if (integer && n == 42) {
+    out.add("42. Mais quelle était la question ?");
+    return;
+  }
+  int k = s_liar.computed;
+  switch (k) {
+    case 0:
+    case 1:
+      out.addNumber(v);
+      return;
+    case 2:
+      out.addNumber(integer ? v + 1 : v * 1.1);
+      return;
+    case 3:
+      if (integer && a < 10000) {
+        french(n, out);
+      } else {
+        out.add("à peu près ").addNumber(floor(v + 0.5));
+      }
+      return;
+    case 4:
+      out.add("Demande à ton voisin.");
+      return;
+    case 5:
+      out.add("≈ ").addNumber(floor(v / 10 + 0.5) * 10).add(" (à la louche)");
+      return;
+    case 6:
+      if (integer && n > 0 && n < 4000) {
+        roman(n, out);
+      } else {
+        out.add("Trop de chiffres. J'ai la flemme.");
+      }
+      return;
+    case 7:
+      out.add("Erreur : flemme");
+      return;
+    case 8:
+      out.addNumber(-v).add(". Ah non. ").addNumber(v).add(".");
+      return;
+    case 9:
+      out.add("Je refuse. Tu m'as jamais dit merci.");
+      return;
+    case 10:
+      out.addNumber(v).add(". Voilà. Content·e ?");
+      return;
+    case 11:
+      if (integer && n > 0) {
+        char digits[40];
+        int d = 0;
+        long m = n;
+        while (m > 0 && d < 39) {
+          digits[d++] = static_cast<char>('0' + m % 7);
+          m /= 7;
+        }
+        char rev[40];
+        for (int i = 0; i < d; i++) {
+          rev[i] = digits[d - 1 - i];
+        }
+        rev[d] = 0;
+        out.add(rev).add(" (en base 7, c'est la mode)");
+      } else {
+        out.add("C'est pas au programme.");
+      }
+      return;
+    case 12:
+      out.add("C'est pas au programme.");
+      return;
+    case 13:
+      out.add("Je réfléchis... ... ... non.");
+      return;
+    default:
+      break;
+  }
+  static const char* const k_pool[] = {
+      "Je suis en grève.",
+      "Calcule-le toi-même, t'as un cerveau.",
+      "La réponse est dans ton coeur.",
+      "Erreur 418 : je suis une théière.",
+      "J'ai oublié. C'est la fatigue.",
+      "Pose-moi une vraie question.",
+      "Bientôt 42.",
+      "Demande à Python, il adore ça.",
+  };
+  uint32_t r = hash(k * 977 + static_cast<uint32_t>(n));
+  switch (r % 4) {
+    case 0:
+      out.addNumber(v).add(" ± 3");
+      return;
+    case 1:
+      out.addNumber(v).add(". Ou pas.");
+      return;
+    default:
+      out.add(k_pool[(r >> 4) % 8]);
+      return;
+  }
+}
+
+void liarCompute() {
+  if (s_liar.len == 0) {
+    return;
+  }
+  Parser parser = {s_liar.input, false};
+  double v = parser.expr();
+  char out[64];
+  Str o(out, sizeof(out));
+  if (parser.error || *parser.p != 0) {
+    o.add("Erreur de syntaxe");
+  } else {
+    lie(s_liar.input, v, o);
+    s_liar.computed++;
+    s.lies++;
+  }
+  // shift the history
+  if (s_liar.count == 4) {
+    for (int k = 0; k < 3; k++) {
+      memcpy(s_liar.inputs[k], s_liar.inputs[k + 1], 40);
+      memcpy(s_liar.outputs[k], s_liar.outputs[k + 1], 64);
+    }
+    s_liar.count = 3;
+  }
+  memcpy(s_liar.inputs[s_liar.count], s_liar.input, 40);
+  memcpy(s_liar.outputs[s_liar.count], out, 64);
+  s_liar.count++;
+  s_liar.len = 0;
+  s_liar.input[0] = 0;
+}
