+        float y = 66 - 24 * sinf((cx - 30) / 14.f);
+        if (fabsf(cy - y) < 1.2f) {
+          c = KDColor::RGB24(0xC53431);
+        }
+        float y2 = 66 - (cx - 30) * (cx - 30) / 260.f;
+        if (fabsf(cy - y2) < 1.0f && cx > 30) {
+          c = KDColor::RGB24(0x3D6FD8);
+        }
+        if (cy > 104) {
+          c = KDColor::RGB24(0xEEEEEE);
+          if (cy > 108 && cy < 116 && cx > 4 && cx < 70 && ((cx / 3) % 2)) {
+            c = KDColor::RGB24(0x404040);
+          }
+        }
+      }
+      g_colors[cy * W + cx] = c;
+    }
+  }
+}
