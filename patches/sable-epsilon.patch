diff --git a/epsilon/apps/home/sable/world.cpp b/epsilon/apps/home/sable/world.cpp
new file mode 100644
index 0000000000..bcaa774a3e
--- /dev/null
+++ b/epsilon/apps/home/sable/world.cpp
@@ -0,0 +1,985 @@
+#include "world.h"
+
+#include <math.h>
+#include <string.h>
+
+namespace Home {
+namespace Sable {
+
+uint8_t g_grid[k_cells];
+uint16_t* g_colors = nullptr;
+
+namespace World {
+
+namespace {
+
+uint32_t s_random = 0x9E3779B9;
+uint8_t s_tick = 0;  // 0 or 0x80
+int s_gravity = 0;
+int s_gx = 0, s_gy = 1;  // gravity
+int s_px = 1, s_py = 0;  // perpendicular
+bool s_floorOpen = false;
+bool s_psyche = false;
+uint32_t s_now = 0;
+uint32_t s_lastNow = 0;
+uint32_t s_freezeStart = 0;
+uint32_t s_freezeDuration = 0;
+bool s_freezing = false;
+int s_keep = 256;
+uint32_t s_booms = 0;
+uint32_t s_boomX = 80, s_boomY = 60;
+uint32_t s_burning = 0;
+uint32_t s_virus = 0;
+uint32_t s_burnCount = 0, s_virusCount = 0;
+
+constexpr uint32_t rgb565(uint32_t c) {
+  return ((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0) | ((c >> 3) & 0x001F);
+}
+
+// Base colors (variant 0..7 adds a little shade)
+constexpr uint32_t k_base[NumberOfMats] = {
+    0x000000,  // Air (sky)
+    0xE6BE6E,  // Sand
+    0x2F6FD8,  // Water
+    0x77777F,  // Stone
+    0xFF5A1A,  // Lava
+    0xFFB21A,  // Fire
+    0x8C8A99,  // Smoke
+    0x8A5A2B,  // Wood
+    0x3DBA4E,  // Plant
+    0xA8E4FF,  // Ice
+    0x8BFF3A,  // Acid
+    0x4A4650,  // Powder
+    0xB0A890,  // Statue (no color)
+    0xB7A58C,  // Dust (no color)
+    0xFFD23F,  // Gold
+    0xB43CFF,  // Virus
+};
+
+uint16_t s_palette[NumberOfMats][8];
+uint16_t s_sky[H];
+
+inline uint8_t make(Mat m, int variant) {
+  return static_cast<uint8_t>(m | ((variant & 7) << 4)) | s_tick;
+}
+
+inline bool frozenCell(int i) {
+  return s_freezing && releaseTime(i) > s_now;
+}
+
+inline void swapCells(int i, int j) {
+  uint8_t a = g_grid[i];
+  g_grid[i] = g_grid[j];
+  g_grid[j] = static_cast<uint8_t>((a & 0x7F) | s_tick);
+  if (g_colors) {
+    uint16_t c = g_colors[i];
+    g_colors[i] = g_colors[j];
+    g_colors[j] = c;
+  }
+}
+
+/* Density order: what a moving cell can push away. Returns true if `mover`
+ * may swap with the content of cell j. */
+inline bool canEnter(Mat mover, int j) {
+  Mat t = matAt(j);
+  if (t == Air) {
+    return !frozenCell(j);
+  }
+  if (frozenCell(j)) {
+    return false;
+  }
+  switch (mover) {
+    case Sand:
+    case Dust:
+    case Gold:
+    case Powder:
+    case Virus:
+      if (t == Smoke || t == Fire) {
+        return true;
+      }
+      if (t == Water || t == Acid) {
+        return (rnd() & 3) != 0;
+      }
+      if (t == Lava) {
+        return (rnd() & 15) == 0;
+      }
+      return false;
+    case Water:
+    case Acid:
+      return t == Smoke || t == Fire;
+    case Lava:
+      return t == Smoke || t == Fire || ((t == Water) && (rnd() & 7) == 0);
+    default:
+      return false;
+  }
+}
+
+/* Moves cell (x, y) by (dx, dy) if possible. Out of the grid: the floor
+ * may be open (the cell falls out), otherwise it is a wall. */
+inline bool tryMove(int x, int y, int dx, int dy, Mat m) {
+  int nx = x + dx, ny = y + dy;
+  if (!inside(nx, ny)) {
+    if (s_floorOpen && dx == s_gx && dy == s_gy) {
+      g_grid[y * W + x] = Air | s_tick;
+      return true;
+    }
+    return false;
+  }
+  int i = y * W + x, j = ny * W + nx;
+  if (canEnter(m, j)) {
+    swapCells(i, j);
+    return true;
+  }
+  return false;
+}
+
+inline int neighbor(int x, int y, int k, int* nx, int* ny) {
+  static constexpr int dx[4] = {1, -1, 0, 0};
+  static constexpr int dy[4] = {0, 0, 1, -1};
+  *nx = x + dx[k];
+  *ny = y + dy[k];
+  return inside(*nx, *ny) ? *ny * W + *nx : -1;
+}
+
+void boom(int x, int y) {
+  s_booms++;
+  s_boomX = x;
+  s_boomY = y;
+}
+
+void granular(int x, int y, Mat m) {
+  int gx = s_gx, gy = s_gy;
+  if (tryMove(x, y, gx, gy, m)) {
+    return;
+  }
+  int s = (rnd() & 1) ? 1 : -1;
+  // Gold is heavy and lazy, dust slides easily
+  if (m == Gold && (rnd() & 1)) {
+    return;
+  }
+  if (tryMove(x, y, gx + s * s_px, gy + s * s_py, m)) {
+    return;
+  }
+  tryMove(x, y, gx - s * s_px, gy - s * s_py, m);
+}
+
+void liquid(int x, int y, Mat m, int spread) {
+  int gx = s_gx, gy = s_gy;
+  if (tryMove(x, y, gx, gy, m)) {
+    return;
+  }
+  int s = (rnd() & 1) ? 1 : -1;
+  if (tryMove(x, y, gx + s * s_px, gy + s * s_py, m) ||
+      tryMove(x, y, gx - s * s_px, gy - s * s_py, m)) {
+    return;
+  }
+  // Flow sideways: go as far as possible (up to `spread` cells)
+  int cx = x, cy = y;
+  for (int k = 0; k < spread; k++) {
+    int nx = cx + s * s_px, ny = cy + s * s_py;
+    if (!inside(nx, ny)) {
+      break;
+    }
+    int j = ny * W + nx;
+    if (!canEnter(m, j)) {
+      break;
+    }
+    swapCells(cy * W + cx, j);
+    cx = nx;
+    cy = ny;
+    // Fall as soon as possible
+    int bx = cx + gx, by = cy + gy;
+    if (inside(bx, by) && matAt(by * W + bx) == Air &&
+        !frozenCell(by * W + bx)) {
+      break;
+    }
+  }
+}
+
+void rising(int x, int y, Mat m) {
+  int s = static_cast<int>(rnd() % 3) - 1;
+  int dx = -s_gx + s * s_px, dy = -s_gy + s * s_py;
+  int nx = x + dx, ny = y + dy;
+  if (!inside(nx, ny)) {
+    if (m == Smoke && (rnd() & 7) == 0) {
+      g_grid[y * W + x] = Air | s_tick;  // leaves through the sky
+    }
+    return;
+  }
+  int j = ny * W + nx;
+  if (matAt(j) == Air && !frozenCell(j)) {
+    swapCells(y * W + x, j);
+  } else if (matAt(j) == Water && m == Smoke && (rnd() & 3) == 0) {
+    swapCells(y * W + x, j);  // bubbles
+  }
+}
+
+void ignite(int j) {
+  g_grid[j] = make(Fire, rnd() & 7);
+}
+
+void updateFire(int x, int y, int i) {
+  s_burnCount++;
+  uint32_t r = rnd();
+  // Neighbours: catch fire, explode, boil
+  for (int k = 0; k < 4; k++) {
+    int nx, ny;
+    int j = neighbor(x, y, k, &nx, &ny);
+    if (j < 0) {
+      continue;
+    }
+    Mat t = matAt(j);
+    uint32_t q = rnd();
+    switch (t) {
+      case Wood:
+        if ((q & 31) == 0) {
+          ignite(j);
+        }
+        break;
+      case Plant:
+        if ((q & 7) == 0) {
+          ignite(j);
+        }
+        break;
+      case Virus:
+        if ((q & 3) == 0) {
+          ignite(j);
+        }
+        break;
+      case Powder:
+        explode(nx, ny, 6);
+        return;
+      case Water:
+        if ((q & 1) == 0) {
+          g_grid[i] = make(Smoke, 4 + (q >> 8) % 4);
+          g_grid[j] = make(Smoke, 4 + (q >> 12) % 4);
+          return;
+        }
+        break;
+      case Ice:
+        if ((q & 15) == 0) {
+          g_grid[j] = make(Water, q >> 8);
+        }
+        break;
+      default:
+        break;
+    }
+  }
+  if ((r & 7) == 0) {
+    g_grid[i] = (r & 0x100) ? make(Smoke, (r >> 9) & 3) : (Air | s_tick);
+    return;
+  }
+  if ((r & 0x30) == 0) {
+    rising(x, y, Fire);
+  }
+}
+
+void updateLava(int x, int y, int i) {
+  s_burnCount++;
+  for (int k = 0; k < 4; k++) {
+    int nx, ny;
+    int j = neighbor(x, y, k, &nx, &ny);
+    if (j < 0) {
+      continue;
+    }
+    Mat t = matAt(j);
+    uint32_t q = rnd();
+    switch (t) {
+      case Water:
+        g_grid[i] = make(Stone, q);
+        g_grid[j] = make(Smoke, 4 + (q >> 8) % 4);
+        return;
+      case Ice:
+        g_grid[j] = make(Water, q);
+        break;
+      case Wood:
+      case Plant:
+      case Virus:
+        if ((q & 7) == 0) {
+          ignite(j);
+        }
+        break;
+      case Powder:
+        explode(nx, ny, 6);
+        return;
+      case Air:
+        // Sparks above the lava
+        if (nx - x == -s_gx && ny - y == -s_gy && (q & 255) == 0) {
+          ignite(j);
+        }
+        break;
+      default:
+        break;
+    }
+  }
+  if (rnd() & 1) {
+    liquid(x, y, Lava, 1);
+  }
+}
+
+void updateAcid(int x, int y, int i) {
+  int nx, ny;
+  int j = neighbor(x, y, rnd() & 3, &nx, &ny);
+  if (j >= 0) {
+    Mat t = matAt(j);
+    if (t != Air && t != Acid && t != Statue && t != Smoke && !frozenCell(j)) {
+      uint32_t q = rnd();
+      int chance = t == Stone ? 63 : (t == Gold ? 31 : 7);
+      if ((q & chance) == 0) {
+        g_grid[j] = (q & 0x100) ? make(Smoke, 0) : (Air | s_tick);
+        if (q & 0x200) {
+          g_grid[i] = Air | s_tick;
+          return;
+        }
+      }
+    }
+  }
+  liquid(x, y, Acid, 3);
+}
+
+void updateVirus(int x, int y, int i) {
+  s_virusCount++;
+  uint32_t q = rnd();
+  if ((q & 1023) == 0) {
+    g_grid[i] = make(Dust, q >> 10);
+    return;
+  }
+  int nx, ny;
+  int j = neighbor(x, y, (q >> 4) & 3, &nx, &ny);
+  if (j >= 0 && (q & 0x300) == 0) {
+    Mat t = matAt(j);
+    if (t == Sand || t == Water || t == Plant || t == Wood || t == Dust ||
+        t == Gold || t == Ice || t == Powder) {
+      g_grid[j] = make(Virus, q >> 12);
+    }
+  }
+  granular(x, y, Virus);
+}
+
+void updatePlant(int x, int y) {
+  uint32_t q = rnd();
+  if ((q & 7) != 0) {
+    return;
+  }
+  int nx, ny;
+  int j = neighbor(x, y, (q >> 3) & 3, &nx, &ny);
+  if (j >= 0 && matAt(j) == Water && ((q >> 5) & 7) == 0) {
+    g_grid[j] = make(Plant, q >> 9);
+  }
+}
+
+void updateIce(int x, int y) {
+  uint32_t q = rnd();
+  if ((q & 15) != 0) {
+    return;
+  }
+  int nx, ny;
+  int j = neighbor(x, y, (q >> 4) & 3, &nx, &ny);
+  if (j >= 0 && matAt(j) == Water && ((q >> 6) & 7) == 0) {
+    g_grid[j] = make(Ice, q >> 9);
+  }
+}
+
+void updateSmoke(int x, int y, int i) {
+  int v = variantAt(i);
+  uint32_t q = rnd();
+  if (v >= 4) {
+    // Steam: condenses into rain up there, or vanishes
+    bool high = s_gy != 0 ? (s_gy > 0 ? y < 16 : y > H - 17)
+                          : (s_gx > 0 ? x < 16 : x > W - 17);
+    if (high && (q & 127) == 0) {
+      g_grid[i] = make(Water, q >> 8);
+      return;
+    }
+    if ((q & 511) == 0) {
+      g_grid[i] = Air | s_tick;
+      return;
+    }
+  } else if ((q & 31) == 0) {
+    g_grid[i] = Air | s_tick;
+    return;
+  }
+  rising(x, y, Smoke);
+}
+
+void updateCell(int x, int y) {
+  int i = y * W + x;
+  uint8_t c = g_grid[i];
+  if ((c & 0x80) == s_tick) {
+    return;  // already moved during this step
+  }
+  Mat m = static_cast<Mat>(c & 15);
+  g_grid[i] = static_cast<uint8_t>((c & 0x7F) | s_tick);
+  switch (m) {
+    case Air:
+    case Stone:
+    case Statue:
+    case Wood:
+      return;
+    case Sand:
+    case Dust:
+    case Gold:
+    case Powder:
+      granular(x, y, m);
+      return;
+    case Water:
+      liquid(x, y, Water, 4);
+      return;
+    case Lava:
+      updateLava(x, y, i);
+      return;
+    case Fire:
+      updateFire(x, y, i);
+      return;
+    case Smoke:
+      updateSmoke(x, y, i);
+      return;
+    case Plant:
+      updatePlant(x, y);
+      return;
+    case Ice:
+      updateIce(x, y);
+      return;
+    case Acid:
+      updateAcid(x, y, i);
+      return;
+    case Virus:
+      updateVirus(x, y, i);
+      return;
+    default:
+      return;
+  }
+}
+
+void releaseFrozen() {
+  for (int i = 0; i < k_cells; i++) {
+    uint32_t t = releaseTime(i);
+    if (t <= s_lastNow || t > s_now) {
+      continue;
+    }
+    uint16_t c = g_colors[i];
+    int r = (c >> 11) << 3, g = ((c >> 5) & 63) << 2, b = (c & 31) << 3;
+    int maxc = r > g ? (r > b ? r : b) : (g > b ? g : b);
+    int minc = r < g ? (r < b ? r : b) : (g < b ? g : b);
+    bool light = maxc > 200 && maxc - minc < 40;
+    if (!light && matAt(i) == Air &&
+        (s_keep >= 256 || static_cast<int>(rnd() & 255) < s_keep)) {
+      g_grid[i] = make(Dust, rnd());
+    }
+  }
+}
+
+}  // namespace
+
+uint32_t rnd() {
+  s_random ^= s_random << 13;
+  s_random ^= s_random >> 17;
+  s_random ^= s_random << 5;
+  return s_random;
+}
+
+uint32_t hash(uint32_t x) {
+  x ^= x >> 16;
+  x *= 0x7feb352dU;
+  x ^= x >> 15;
+  x *= 0x846ca68bU;
+  x ^= x >> 16;
+  return x;
+}
+
+Mat at(int x, int y) {
+  if (!inside(x, y)) {
+    return Stone;
+  }
+  return matAt(y * W + x);
+}
+
+void set(int x, int y, Mat m) { setVariant(x, y, m, rnd()); }
+
+void setVariant(int x, int y, Mat m, int variant) {
+  if (inside(x, y)) {
+    g_grid[y * W + x] = make(m, variant);
+  }
+}
+
+void setColored(int x, int y, Mat m, uint16_t color) {
+  if (inside(x, y)) {
+    g_grid[y * W + x] = make(m, rnd());
+    if (g_colors) {
+      g_colors[y * W + x] = color;
+    }
+  }
+}
+
+bool isGranular(Mat m) {
+  return m == Sand || m == Dust || m == Gold || m == Powder || m == Virus;
+}
+
+bool isLiquid(Mat m) { return m == Water || m == Acid || m == Lava; }
+
+const char* name(Mat m) {
+  static const char* const k_names[NumberOfMats] = {
+      "Gomme", "Sable",  "Eau",     "Pierre", "Lave",   "Feu",
+      "Fum\xC3\xA9\x65", "Bois",    "Plante", "Glace",  "Acide",
+      "Poudre", "Statue", "Poussi\xC3\xA8re", "Or", "Virus"};
+  return k_names[m];
+}
+
+KDColor sample(Mat m) { return KDColor::RGB16(s_palette[m][3]); }
+
+void clear() {
+  memset(g_grid, 0, sizeof(g_grid));
+  s_tick = 0;
+}
+
+void init(uint32_t seed) {
+  if (seed) {
+    s_random ^= seed;
+  }
+  for (int m = 0; m < NumberOfMats; m++) {
+    KDColor base = KDColor::RGB24(k_base[m]);
+    for (int v = 0; v < 8; v++) {
+      int k = (v - 3) * 9;
+      int r = clampi(base.red() + k, 0, 255);
+      int g = clampi(base.green() + k, 0, 255);
+      int b = clampi(base.blue() + k, 0, 255);
+      s_palette[m][v] = KDColor::RGB888(r, g, b);
+    }
+  }
+  // Night sky over the desert
+  for (int y = 0; y < H; y++) {
+    int t = y * 256 / H;
+    KDColor top = KDColor::RGB24(0x0A0820);
+    KDColor bottom = KDColor::RGB24(0x3B1C3E);
+    s_sky[y] = mix(top, bottom, t);
+  }
+}
+
+void setGravity(int g) {
+  s_gravity = g & 3;
+  static constexpr int gx[4] = {0, 1, 0, -1};
+  static constexpr int gy[4] = {1, 0, -1, 0};
+  s_gx = gx[s_gravity];
+  s_gy = gy[s_gravity];
+  s_px = -s_gy;
+  s_py = s_gx;
+}
+
+int gravity() { return s_gravity; }
+void openFloor(bool open) { s_floorOpen = open; }
+bool floorIsOpen() { return s_floorOpen; }
+
+void freeze(uint32_t start, uint32_t duration) {
+  s_freezeStart = start;
+  s_freezeDuration = duration;
+  s_freezing = g_colors != nullptr;
+  s_lastNow = start;
+  // Do not fill the world with an app's full screen of dust
+  int dark = 0;
+  if (g_colors) {
+    for (int i = 0; i < k_cells; i++) {
+      uint16_t c = g_colors[i];
+      int r = (c >> 11) << 3, g = ((c >> 5) & 63) << 2, b = (c & 31) << 3;
+      int maxc = r > g ? (r > b ? r : b) : (g > b ? g : b);
+      int minc = r < g ? (r < b ? r : b) : (g < b ? g : b);
+      if (!(maxc > 200 && maxc - minc < 40)) {
+        dark++;
+      }
+    }
+  }
+  constexpr int k_maxDust = 3800;
+  s_keep = dark > k_maxDust ? k_maxDust * 256 / dark : 256;
+}
+
+bool isFreezing(uint32_t now) {
+  return s_freezing && now < s_freezeStart + s_freezeDuration + 400;
+}
+
+uint32_t releaseTime(int i) {
+  int x = i % W, y = i / W;
+  // Depth from the floor, 0 near the floor
+  int d;
+  switch (s_gravity) {
+    case 0:
+      d = H - 1 - y;
+      break;
+    case 1:
+      d = (W - 1 - x) * H / W;
+      break;
+    case 2:
+      d = y;
+      break;
+    default:
+      d = x * H / W;
+      break;
+  }
+  // A diagonal sweep plus noise: the image crumbles like a dry sand castle
+  uint32_t sweep = (d * 55 + x * 12 * (s_gravity == 0 ? 1 : 0)) *
+                   s_freezeDuration / (100 * H);
+  uint32_t noise = hash(i) % (s_freezeDuration * 45 / 100 + 1);
+  return s_freezeStart + 120 + sweep + noise;
+}
+
+void step(uint32_t now) {
+  s_lastNow = s_now;
+  s_now = now;
+  if (s_freezing) {
+    if (g_colors) {
+      releaseFrozen();
+    }
+    if (now > s_freezeStart + s_freezeDuration + 400) {
+      s_freezing = false;
+    }
+  }
+  s_tick ^= 0x80;
+  s_burnCount = 0;
+  s_virusCount = 0;
+  bool flip = s_tick != 0;
+  switch (s_gravity) {
+    case 0:
+      for (int y = H - 1; y >= 0; y--) {
+        if (flip) {
+          for (int x = 0; x < W; x++) updateCell(x, y);
+        } else {
+          for (int x = W - 1; x >= 0; x--) updateCell(x, y);
+        }
+        flip = !flip;
+      }
+      break;
+    case 2:
+      for (int y = 0; y < H; y++) {
+        if (flip) {
+          for (int x = 0; x < W; x++) updateCell(x, y);
+        } else {
+          for (int x = W - 1; x >= 0; x--) updateCell(x, y);
+        }
+        flip = !flip;
+      }
+      break;
+    case 1:
+      for (int x = W - 1; x >= 0; x--) {
+        if (flip) {
+          for (int y = 0; y < H; y++) updateCell(x, y);
+        } else {
+          for (int y = H - 1; y >= 0; y--) updateCell(x, y);
+        }
+        flip = !flip;
+      }
+      break;
+    default:
+      for (int x = 0; x < W; x++) {
+        if (flip) {
+          for (int y = 0; y < H; y++) updateCell(x, y);
+        } else {
+          for (int y = H - 1; y >= 0; y--) updateCell(x, y);
+        }
+        flip = !flip;
+      }
+      break;
+  }
+  s_burning = s_burnCount;
+  s_virus = s_virusCount;
+}
+
+void render(Band& b, uint32_t now) {
+  Rect area = b.area();
+  uint32_t flick = now / 90;
+  uint32_t slow = now / 260;
+  bool freezing = s_freezing && g_colors;
+  uint32_t savedNow = s_now;
+  s_now = now;
+  for (int py = area.y; py < area.bottom(); py++) {
+    KDColor* row = b.row(py);
+    int cy = py >> 1;
+    if (cy >= H) {
+      break;
+    }
+    if ((py & 1) && py > area.y) {
+      // Same cells as the row above
+      memcpy(row + area.x, b.row(py - 1) + area.x, area.w * sizeof(KDColor));
+      continue;
+    }
+    const uint8_t* line = g_grid + cy * W;
+    uint16_t sky = s_sky[cy];
+    for (int cx = 0; cx < W; cx++) {
+      int i = cy * W + cx;
+      uint8_t c = line[cx];
+      Mat m = static_cast<Mat>(c & 15);
+      int v = (c >> 4) & 7;
+      uint16_t col;
+      if (freezing && releaseTime(i) > now) {
+        col = g_colors[i];
+      } else {
+        switch (m) {
+          case Air: {
+            col = sky;
+            uint32_t h = hash(i * 31 + 7);
+            if ((h & 255) == 0 && cy < H - 30) {
+              // twinkling star
+              int tw = static_cast<int>((h >> 8) + slow) & 7;
+              col = tw < 5 ? KDColor::RGB888(220, 220, 255)
+                           : KDColor::RGB888(90, 90, 140);
+            }
+            break;
+          }
+          case Water: {
+            uint32_t h = hash(i + (slow << 16));
+            col = s_palette[Water][(v + (h & 1)) & 7];
+            if (cy > 0 && matAt(i - W) == Air) {
+              col = KDColor::RGB888(120, 180, 255);  // surface
+            }
+            break;
+          }
+          case Lava: {
+            uint32_t h = hash(i * 7 + flick * 131);
+            col = (h & 7) == 0 ? static_cast<uint16_t>(KDColor::RGB888(255, 210, 60))
+                               : s_palette[Lava][(v + (h >> 4)) & 7];
+            break;
+          }
+          case Fire: {
+            uint32_t h = hash(i * 13 + flick * 977) % 3;
+            col = h == 0   ? KDColor::RGB888(255, 240, 120)
+                  : h == 1 ? KDColor::RGB888(255, 150, 30)
+                           : KDColor::RGB888(230, 60, 20);
+            break;
+          }
+          case Smoke:
+            col = v >= 4 ? mix(KDColor::RGB16(sky),
+                               KDColor::RGB888(230, 236, 255), 140)
+                         : mix(KDColor::RGB16(sky),
+                               KDColor::RGB888(140, 135, 150), 150 + v * 10);
+            break;
+          case Gold: {
+            uint32_t h = hash(i * 3 + flick * 7919);
+            col = (h % 61) == 0 ? static_cast<uint16_t>(KDColor::RGB888(255, 255, 230))
+                                : s_palette[Gold][v];
+            break;
+          }
+          case Ice: {
+            uint32_t h = hash(i * 5 + slow * 104729);
+            col = (h % 97) == 0 ? static_cast<uint16_t>(KDColor::RGB888(255, 255, 255))
+                                : s_palette[Ice][v];
+            break;
+          }
+          case Acid: {
+            uint32_t h = hash(i + flick * 31337);
+            col = s_palette[Acid][(v + (h & 3)) & 7];
+            break;
+          }
+          case Virus: {
+            int phase = static_cast<int>((now / 40 + cx * 3 + cy * 5) & 63);
+            int k = phase < 32 ? phase * 8 : (63 - phase) * 8;
+            col = mix(KDColor::RGB24(0x5A0F8C), KDColor::RGB24(0x5CFF4A), k);
+            break;
+          }
+          case Statue:
+          case Dust:
+            col = g_colors ? g_colors[i] : s_palette[m][v];
+            break;
+          default:
+            col = s_palette[m][v];
+            break;
+        }
+      }
+      if (s_psyche && m != Air) {
+        col = hsv(static_cast<int>((cx * 4 + cy * 3 + v * 20 + now / 8) % 360),
+                  220, 255);
+      }
+      row[2 * cx] = KDColor::RGB16(col);
+      row[2 * cx + 1] = KDColor::RGB16(col);
+    }
+  }
+  s_now = savedNow;
+}
+
+void explode(int cx, int cy, int r) {
+  boom(cx, cy);
+  for (int y = cy - r - 2; y <= cy + r + 2; y++) {
+    for (int x = cx - r - 2; x <= cx + r + 2; x++) {
+      if (!inside(x, y)) {
+        continue;
+      }
+      int dx = x - cx, dy = y - cy;
+      int d2 = dx * dx + dy * dy;
+      int i = y * W + x;
+      Mat m = matAt(i);
+      if (m == Statue || frozenCell(i)) {
+        continue;
+      }
+      uint32_t q = rnd();
+      if (d2 <= r * r * 2 / 5) {
+        g_grid[i] = (q & 1) ? make(Fire, q >> 4) : (Air | s_tick);
+      } else if (d2 <= r * r) {
+        if (m == Powder) {
+          g_grid[i] = make(Fire, q >> 4);  // chain reaction
+        } else {
+          g_grid[i] = (q & 3) == 0 ? make(Fire, q >> 4)
+                                   : ((q & 12) == 0 ? make(Smoke, q >> 8)
+                                                    : (Air | s_tick));
+        }
+      } else if (d2 <= (r + 2) * (r + 2) && (m == Wood || m == Plant) &&
+                 (q & 3) == 0) {
+        g_grid[i] = make(Fire, q >> 4);
+      }
+    }
+  }
+}
+
+void blob(int cx, int cy, int r, Mat m, int chance256, bool replace) {
+  for (int y = cy - r; y <= cy + r; y++) {
+    for (int x = cx - r; x <= cx + r; x++) {
+      if (!inside(x, y)) {
+        continue;
+      }
+      int dx = x - cx, dy = y - cy;
+      if (dx * dx + dy * dy > r * r) {
+        continue;
+      }
+      int i = y * W + x;
+      Mat t = matAt(i);
+      if (t == Statue || frozenCell(i)) {
+        continue;
+      }
+      if (!replace && t != Air && m != Air) {
+        continue;
+      }
+      if (static_cast<int>(rnd() & 255) < chance256) {
+        g_grid[i] = make(m, rnd());
+      }
+    }
+  }
+}
+
+void line(int x0, int y0, int x1, int y1, Mat m, int width) {
+  int dx = x1 - x0, dy = y1 - y0;
+  int n = (dx < 0 ? -dx : dx) > (dy < 0 ? -dy : dy) ? (dx < 0 ? -dx : dx)
+                                                    : (dy < 0 ? -dy : dy);
+  if (n == 0) {
+    n = 1;
+  }
+  for (int k = 0; k <= n; k++) {
+    int x = x0 + dx * k / n, y = y0 + dy * k / n;
+    for (int a = 0; a < width; a++) {
+      for (int b = 0; b < width; b++) {
+        int xx = x + a - width / 2, yy = y + b - width / 2;
+        if (inside(xx, yy) && matAt(yy * W + xx) != Statue) {
+          g_grid[yy * W + xx] = make(m, rnd());
+        }
+      }
+    }
+  }
+}
+
+void blackHole(int cx, int cy, int r) {
+  for (int y = cy - r; y <= cy + r; y++) {
+    for (int x = cx - r; x <= cx + r; x++) {
+      if (!inside(x, y)) {
+        continue;
+      }
+      int i = y * W + x;
+      Mat m = matAt(i);
+      if (m == Air || m == Statue) {
+        continue;
+      }
+      int dx = cx - x, dy = cy - y;
+      int d2 = dx * dx + dy * dy;
+      if (d2 > r * r) {
+        continue;
+      }
+      if (d2 <= 5) {
+        g_grid[i] = Air | s_tick;
+        continue;
+      }
+      // Spiral in: toward the center plus a quarter turn
+      float d = sqrtf(static_cast<float>(d2));
+      float fx = dx / d + 0.8f * (-dy) / d;
+      float fy = dy / d + 0.8f * dx / d;
+      int sx = fx > 0.35f ? 1 : (fx < -0.35f ? -1 : 0);
+      int sy = fy > 0.35f ? 1 : (fy < -0.35f ? -1 : 0);
+      int nx = x + sx, ny = y + sy;
+      if (inside(nx, ny) && matAt(ny * W + nx) == Air) {
+        swapCells(i, ny * W + nx);
+      }
+    }
+  }
+}
+
+void quake(int strength) {
+  for (int k = 0; k < strength; k++) {
+    int i = rnd() % k_cells;
+    Mat m = matAt(i);
+    if (m == Stone && (rnd() & 3) == 0) {
+      g_grid[i] = make(Sand, rnd());
+    } else if (isGranular(m) || isLiquid(m)) {
+      int x = i % W, y = i / W;
+      int nx = x + static_cast<int>(rnd() % 3) - 1;
+      int ny = y - static_cast<int>(rnd() % 3);
+      if (inside(nx, ny) && matAt(ny * W + nx) == Air) {
+        swapCells(i, ny * W + nx);
+      }
+    }
+  }
+}
+
+void wind(int dx, int n) {
+  for (int k = 0; k < n; k++) {
+    int i = rnd() % k_cells;
+    Mat m = matAt(i);
+    if (!(isGranular(m) || isLiquid(m) || m == Smoke || m == Fire)) {
+      continue;
+    }
+    int x = i % W, y = i / W;
+    int nx = x + dx, ny = y - static_cast<int>(rnd() & 1);
+    if (inside(nx, ny) && matAt(ny * W + nx) == Air && !frozenCell(ny * W + nx)) {
+      swapCells(i, ny * W + nx);
+    }
+  }
+}
+
+void setPsyche(bool on) { s_psyche = on; }
+
+int count() {
+  int n = 0;
+  for (int i = 0; i < k_cells; i++) {
+    Mat m = matAt(i);
+    n += m != Air && m != Statue && m != Smoke && m != Fire;
+  }
+  return n;
+}
+
+int countOf(Mat m) {
+  int n = 0;
+  for (int i = 0; i < k_cells; i++) {
+    n += matAt(i) == m;
+  }
+  return n;
+}
+
+void clearStatues() {
+  for (int i = 0; i < k_cells; i++) {
+    if (matAt(i) == Statue) {
+      g_grid[i] = Air;
+    }
+  }
+}
+
+void shuffle(int x0, int y0, int x1, int y1) {
+  for (int y = y0; y < y1; y++) {
+    for (int x = x0; x < x1; x++) {
+      if (inside(x, y) && matAt(y * W + x) == Statue) {
+        g_grid[y * W + x] = Air;
+      }
+    }
+  }
+}
+
+uint32_t booms() { return s_booms; }
+uint32_t burning() { return s_burning; }
+uint32_t virusCount() { return s_virus; }
+uint32_t lastBoomX() { return s_boomX; }
+uint32_t lastBoomY() { return s_boomY; }
+
+}  // namespace World
+
+}  // namespace Sable
+}  // namespace Home
diff --git a/epsilon/apps/home/sable/world.h b/epsilon/apps/home/sable/world.h
new file mode 100644
index 0000000000..1a9bafeaf5
--- /dev/null
+++ b/epsilon/apps/home/sable/world.h
@@ -0,0 +1,139 @@
+#pragma once
+
+/* SABLE: the world. Every pixel of the home screen is a grain of matter.
+ *
+ * The screen is a grid of 160 x 120 cells of 2 x 2 pixels (a "falling sand"
+ * cellular automaton). Each cell is one byte: the material in the low
+ * nibble, a variant (shade, life) in bits 4-6 and the parity of the last
+ * step that moved it in bit 7. The grid is static: the world waits for you
+ * while you are in an app or a game.
+ *
+ * Statues (the apps), dust and the frozen image of the app you leave have
+ * their own colors: one RGB565 color per cell, stored in the home App object
+ * (it only exists while the home screen is open, see g_colors). */
+
+#include <stdint.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace Sable {
+
+constexpr int k_cell = 2;
+constexpr int W = 160;
+constexpr int H = 120;
+constexpr int k_cells = W * H;
+
+enum Mat : uint8_t {
+  Air = 0,
+  Sand,
+  Water,
+  Stone,
+  Lava,
+  Fire,
+  Smoke,  // variant >= 4: steam (condenses into water)
+  Wood,
+  Plant,
+  Ice,
+  Acid,
+  Powder,
+  Statue,
+  Dust,
+  Gold,
+  Virus,
+  NumberOfMats
+};
+
+extern uint8_t g_grid[k_cells];
+// Colors of statues and dust (nullptr while the home screen is closed)
+extern uint16_t* g_colors;
+
+namespace World {
+
+inline Mat matAt(int i) { return static_cast<Mat>(g_grid[i] & 15); }
+inline int variantAt(int i) { return (g_grid[i] >> 4) & 7; }
+inline bool inside(int x, int y) {
+  return static_cast<unsigned>(x) < static_cast<unsigned>(W) &&
+         static_cast<unsigned>(y) < static_cast<unsigned>(H);
+}
+Mat at(int x, int y);
+void set(int x, int y, Mat m);
+void setVariant(int x, int y, Mat m, int variant);
+void setColored(int x, int y, Mat m, uint16_t color);
+bool isGranular(Mat m);
+bool isLiquid(Mat m);
+const char* name(Mat m);
+KDColor sample(Mat m);
+
+void clear();
+void init(uint32_t seed);
+/* One simulation step. `now` is used by the animated materials and the
+ * frozen image of the app you left. */
+void step(uint32_t now);
+void render(Band& b, uint32_t now);
+
+/* Gravity: 0 down, 1 right, 2 up, 3 left (the calculator is rotated) */
+void setGravity(int g);
+int gravity();
+// The floor (the side gravity pulls to) is open: matter falls out of it
+void openFloor(bool open);
+bool floorIsOpen();
+
+/* The frozen image of the app you left: until `releaseTime(i)` the cell i
+ * shows g_colors[i] and nothing can enter it. */
+void freeze(uint32_t start, uint32_t duration);
+bool isFreezing(uint32_t now);
+// Called by the shell when the cell is released (dust or nothing)
+uint32_t releaseTime(int i);
+
+// Actions
+void explode(int cx, int cy, int r);
+void blob(int cx, int cy, int r, Mat m, int chance256, bool replace);
+void line(int x0, int y0, int x1, int y1, Mat m, int width);
+void blackHole(int cx, int cy, int r);
+void quake(int strength);
+// Wind: n random grains (and smoke) pushed by one cell along dx
+void wind(int dx, int n);
+// Psychedelic colors (the imaginary world, key i)
+void setPsyche(bool on);
+// Half of the matter vanishes; calls `out(x, y, color)` for each grain
+template <typename F>
+int snapHalf(F out);
+int count();  // grains (no air, no statue)
+int countOf(Mat m);
+void clearStatues();
+void shuffle(int x0, int y0, int x1, int y1);
+
+// Explosions since start (the shell shakes the screen and flashes the LED)
+uint32_t booms();
+uint32_t burning();  // cells of fire or lava seen at the last step
+uint32_t virusCount();
+uint32_t lastBoomX();
+uint32_t lastBoomY();
+
+uint32_t rnd();
+uint32_t hash(uint32_t x);
+
+}  // namespace World
+
+/* ------------------------------------------------------------------ */
+
+template <typename F>
+int World::snapHalf(F out) {
+  int n = 0;
+  for (int i = 0; i < k_cells; i++) {
+    Mat m = matAt(i);
+    if (m == Air || m == Statue) {
+      continue;
+    }
+    if (hash(i * 2654435761u + rnd()) & 1) {
+      out(i % W, i / W, g_colors ? g_colors[i] : 0, m);
+      g_grid[i] = Air;
+      n++;
+    }
+  }
+  return n;
+}
+
+}  // namespace Sable
+}  // namespace Home
