+}  // namespace
+
+/* =========================================================== public */
+
+void open(Mode m) {
+  if (m == Mode::Labo) {
+    setMode(Mode::Labo);
+    return;
+  }
+  setMode(m);
+  clearParticles();
+  switch (m) {
+    case Mode::Menteuse:
+      memset(&s_liar, 0, sizeof(s_liar));
+      break;
+    case Mode::Appel:
+      s_call.phase = 0;
+      s_call.phaseStart = now();
+      break;
+    case Mode::Desintegrateur:
+      memset(&s_dis, 0, sizeof(s_dis));
+      s_dis.preset = -1;
+      disPrepare();
+      Ion::Events::setShiftAlphaStatus(Ion::Events::ShiftAlphaStatus(
+          Ion::Events::ShiftAlphaStatus::ShiftStatus::Inactive,
+          Ion::Events::ShiftAlphaStatus::AlphaStatus::Locked));
+      break;
+    case Mode::Bataille:
+      battleStart();
+      toast("Haut/Bas : angle · Gauche/Droite : force\n1 boulet · 2 eau · 3 lave · 4 TNT · 5 acide", 4000);
+      break;
+    case Mode::Reglages:
+      s_set.sel = 0;
+      s_set.confirmReset = false;
+      break;
+    default:
+      break;
+  }
+}
+
+bool handleMenu(Event e) {
+  if (e == Events::Up) {
+    s.laboSel = (s.laboSel + k_numberOfEntries - 1) % k_numberOfEntries;
+  } else if (e == Events::Down) {
+    s.laboSel = (s.laboSel + 1) % k_numberOfEntries;
+  } else if (e == Events::OK || e == Events::EXE) {
+    open(k_entries[s.laboSel].mode);
+  } else if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+    setMode(Mode::Home);
+  } else {
+    const char* t = e.text();
+    if (t && t[0] >= '1' && t[0] < '1' + k_numberOfEntries && !t[1]) {
+      s.laboSel = t[0] - '1';
+      open(k_entries[s.laboSel].mode);
+    }
+  }
+  return true;
+}
+
+void renderMenu(Band& b) {
+  Rect r = {24, 22, 272, 30 + k_numberOfEntries * 26};
+  if (r.bottom() <= b.area().y || r.y >= b.area().bottom()) {
+    return;
+  }
+  roundFill(b, r, 10, KDColor::RGB24(0x140C28), 235);
+  roundFrame(b, r, 10, KDColor::RGB24(k_sand));
+  outlinedText(b, "LE LABO", 160, 28, KDColor::RGB24(k_sand), Large,
+               Align::Center);
+  for (int k = 0; k < k_numberOfEntries; k++) {
+    int y = 52 + k * 26;
+    bool sel = k == s.laboSel;
+    if (sel) {
+      roundFill(b, {32, y - 2, 256, 25}, 6, KDColor::RGB24(k_sand), 230);
+    }
+    KDColor c = sel ? KDColor::RGB24(k_night) : KDColor::RGB24(k_ink);
+    char n[4] = {static_cast<char>('1' + k), 0};
+    text(b, n, 40, y + 4, sel ? c : KDColor::RGB24(k_sand), Small);
+    text(b, k_entries[k].name, 56, y - 1, c, Small);
+    text(b, k_entries[k].line, 56, y + 10, sel ? KDColor::RGB24(0x4A3A20)
+                                                : KDColor::RGB24(k_dim),
+         Small);
+  }
+}
+
+bool handleEvent(Event e) {
+  switch (s.mode) {
+    case Mode::Sablier:
+      return sablierEvent(e);
+    case Mode::Menteuse:
+      return menteuseEvent(e);
+    case Mode::Appel:
+      return appelEvent(e);
+    case Mode::Desintegrateur:
+      return desintegrateurEvent(e);
+    case Mode::Bataille:
+      return batailleEvent(e);
+    case Mode::Reglages:
+      return reglagesEvent(e);
+    default:
+      if (e == Events::Back || e == Events::Home || e == Events::Toolbox ||
+          e == Events::OK || e == Events::EXE) {
+        back();
+      }
+      return true;
+  }
+}
+
+void update() {
+  switch (s.mode) {
+    case Mode::Appel:
+      updateAppel();
+      break;
+    case Mode::Desintegrateur:
+      updateDesintegrateur();
+      break;
+    case Mode::Bataille:
+      updateBataille();
+      break;
+    default:
+      break;
+  }
+}
+
+void render(Band& b) {
+  switch (s.mode) {
+    case Mode::Sablier:
+      renderSablier(b);
+      break;
+    case Mode::Menteuse:
+      renderMenteuse(b);
+      break;
+    case Mode::Appel:
+      renderAppel(b);
+      break;
+    case Mode::Desintegrateur:
+      renderDesintegrateur(b);
+      break;
+    case Mode::Bataille:
+      renderBataille(b);
+      break;
+    case Mode::Aide:
+      renderAide(b);
+      break;
+    case Mode::Reglages:
+      renderReglages(b);
+      break;
+    default:
+      break;
+  }
+}
+
+uint16_t ledColor(int* intensity) {
+  *intensity = 0;
+  if (s.mode == Mode::Sablier && s.sablierOn && s.sablierRang) {
+    *intensity = 255;
+    return hsv(static_cast<int>(now() / 4 % 360), 255, 255);
+  }
+  if (s.mode == Mode::Appel && s_call.phase == 2) {
+    uint32_t t = now() - s_call.phaseStart;
+    *intensity = (t % 1300) < 650 ? 200 : 0;
+    return KDColor::RGB24(0x30FF60);
+  }
+  if (s.mode == Mode::Desintegrateur && s_dis.phase == 1) {
+    *intensity = 120;
+    return KDColor::RGB24(0xFF8020);
+  }
+  if (s.mode == Mode::Sablier && s.sablierOn &&
+      sablierFraction() * s.sablierDuration < 60000) {
+    *intensity = 60 + static_cast<int>(50 * sinf(now() / 200.f));
+    return KDColor::RGB24(0xFF2020);
+  }
+  return 0;
+}
+
+void renderSablierBadge(Band& b) {
+  char t[24];
+  Str m(t, sizeof(t));
+  float f = sablierFraction();
+  if (s.sablierRang || f <= 0) {
+    m.add("DRING !");
+  } else {
+    formatLeft(m, static_cast<uint32_t>(f * s.sablierDuration));
+  }
+  outlinedText(b, t, 252, 4, KDColor::RGB24(0xFFE7A0), Small, Align::Right);
+}
+
+void updateSablier() {
+  if (!s.sablierOn || s.sablierRang) {
+    if (s.sablierRang && s.mode == Mode::Sablier) {
+      if ((rnd() & 1) == 0) {
+        addParticle(static_cast<int>(rnd() % 320), -4,
+                    static_cast<int>(rnd() % 40) - 20, 40,
+                    hsv(static_cast<int>(rnd() % 360), 200, 255), 255,
+                    Confetti);
+      }
+      if ((now() / 700) % 2 == 0) {
+        shake(40);
+      }
+    }
+    return;
+  }
+  if (now() - s.sablierStart >= s.sablierDuration) {
+    s.sablierRang = true;
+    s_ringStart = now();
+    if (s.mode != Mode::Sablier) {
+      Ion::Events::setShiftAlphaStatus(Ion::Events::ShiftAlphaStatus());
+      setMode(Mode::Sablier);
+    }
+    flash(0xFFFFFF, 200);
+  }
+}
+
+#if !PLATFORM_DEVICE
+void photos(void (*shoot)(const char*), void (*step)(int, const char*, int),
+            void (*press)(Event, int, const char*, int)) {
+  // Sablier
+  open(Mode::Sablier);
+  s.sablierPick = 55;
+  step(100, nullptr, 1);
+  shoot("sablier_reglage");
