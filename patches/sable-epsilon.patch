+    roundFill(b, {14, y, w, h}, 8, KDColor::RGB24(0x2E2648));
+    int hh;
+    wrapText(b, line, 22, y + 4, 34, KDColor::RGB24(k_ink), Align::Left, &hh);
+  }
+  hint(b, s_call.phase == 3 ? "Retour : raccrocher" : "OK : retour au désert");
+}
+
+bool appelEvent(Event e) {
+  if (s_call.phase == 0) {
+    if (e == Events::Up) {
+      s_call.pick = (s_call.pick + k_numberOfCallers) % (k_numberOfCallers + 1);
+    } else if (e == Events::Down) {
+      s_call.pick = (s_call.pick + 1) % (k_numberOfCallers + 1);
+    } else if (e == Events::OK || e == Events::EXE) {
+      s_call.caller = s_call.pick == k_numberOfCallers
+                          ? static_cast<int>(rnd() % k_numberOfCallers)
+                          : s_call.pick;
+      callPhase(1);
+    } else if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+      back();
+    }
+    return true;
+  }
+  if (s_call.phase == 2) {
+    if (e == Events::OK || e == Events::EXE) {
+      s.calls++;
+      callPhase(3);
+    } else if (e == Events::Back || e == Events::Backspace) {
+      callPhase(4);
+    }
+    return true;
+  }
+  if (s_call.phase == 3) {
+    if (e == Events::Back || e == Events::Backspace) {
+      callPhase(5);
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE || e == Events::Back ||
+      e == Events::Home) {
+    back();
+  }
+  return true;
+}
+
+void updateAppel() {
+  uint32_t t = now() - s_call.phaseStart;
+  if (s_call.phase == 1 && t > 5000) {
+    callPhase(2);
+  } else if (s_call.phase == 2) {
+    if ((t % 1300) < 450) {
+      shake(60);  // vibration
+    }
+    if (t > 30000) {
+      callPhase(4);
+    }
+  } else if (s_call.phase == 3) {
+    int n = callerLines(s_call.caller);
+    if (t > static_cast<uint32_t>(n) * k_lineDelay + 1800) {
+      callPhase(5);
+    }
+  } else if (s_call.phase == 4 && t > 2600) {
+    back();
+  }
+}
+
+/* ===================================================== DESINTEGRATEUR */
+
+const char* const k_victims[] = {
+    "LUNDI",       "LES MATHS",  "LE BAC",   "LES DEVOIRS",
+    "LE REVEIL",   "LA CANTINE", "PRONOTE",  "MON BULLETIN",
+    "LES MAJ",     "LE CONTROLE"};
+constexpr int k_numberOfVictims = sizeof(k_victims) / sizeof(k_victims[0]);
+
+constexpr int k_disScale = 2;
+constexpr int k_disY = 72;
+
+int disX0() { return 160 - s_dis.w * k_disScale / 2; }
+
+uint32_t disRelease(int x, int y) {
+  return s_dis.start + 200 + static_cast<uint32_t>(x) * 1400 / (s_dis.w + 1) +
+         hash(y * 977 + x) % 600;
+}
+
+bool disBit(int x, int y) {
+  int b = y * 120 + x;
+  return (s_dis.bits[b >> 3] >> (b & 7)) & 1;
+}
+
+void disPrepare() {
+  int w = 0, h = 0;
+  const char* word = s_dis.len ? s_dis.word : "?";
+  uint8_t mask[120 * 18];
+  textMask(word, Large, mask, 120, 18, &w, &h);
+  memset(s_dis.bits, 0, sizeof(s_dis.bits));
+  for (int i = 0; i < 120 * 18; i++) {
+    if (mask[i]) {
+      s_dis.bits[i >> 3] |= 1 << (i & 7);
+    }
+  }
+  s_dis.w = w;
+  s_dis.h = h;
+}
+
+KDColor marble(int x, int y) {
+  uint32_t h = hash(x * 13 + y * 7);
+  float vein = sinf(x * 0.21f + y * 0.37f + sinf(y * 0.13f) * 2);
+  int k = vein > 0.85f ? 90 : static_cast<int>(h & 15);
+  return mix(KDColor::RGB24(0xF4F0EA), KDColor::RGB24(0x8A8494), k);
+}
+
+void renderDesintegrateur(Band& b) {
+  nightBackground(b);
+  title(b, "DÉSINTÉGRATEUR");
+  Rect area = b.area();
+  int x0 = disX0();
+  // the pedestal
+  fill(b, {60, k_disY + 46, 200, 6}, KDColor::RGB24(0x6A6478));
+  fill(b, {80, k_disY + 52, 160, 30}, KDColor::RGB24(0x4A4458));
+  for (int my = 0; my < s_dis.h; my++) {
+    int py = k_disY + my * k_disScale;
+    if (py + k_disScale <= area.y || py >= area.bottom()) {
+      continue;
+    }
+    for (int mx = 0; mx < s_dis.w; mx++) {
+      if (!disBit(mx, my)) {
+        continue;
+      }
+      if (s_dis.phase >= 1 && disRelease(mx, my) <= now()) {
+        continue;
+      }
+      fill(b, {x0 + mx * k_disScale, py, k_disScale, k_disScale},
+           marble(mx, my));
+    }
+  }
+  if (s_dis.phase == 0) {
+    text(b, "Tape un mot (lettres) ou Haut / Bas : des idées", 160, 160,
+         KDColor::RGB24(k_ink), Small, Align::Center);
+    text(b, "OK : DÉSINTÉGRER", 160, 182, KDColor::RGB24(k_sand), Large,
+         Align::Center);
+    hint(b, "Effacer : effacer une lettre · Retour : quitter");
+  } else if (s_dis.phase == 2) {
+    char t[64];
+    Str m(t, sizeof(t));
+    m.add("\"").add(s_dis.word).add("\" n'existe plus.");
+    outlinedText(b, t, 160, 150, KDColor::RGB24(k_sand), Large, Align::Center);
+    text(b, "Le sable s'en souviendra.", 160, 176, KDColor::RGB24(k_ink),
+         Small, Align::Center);
+    hint(b, "OK : désintégrer autre chose · Retour : quitter");
+  }
+}
+
+bool desintegrateurEvent(Event e) {
+  if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+    back();
+    return true;
+  }
+  if (s_dis.phase == 1) {
+    return true;
+  }
+  if (s_dis.phase == 2) {
+    if (e == Events::OK || e == Events::EXE) {
+      s_dis.phase = 0;
+      s_dis.len = 0;
+      s_dis.word[0] = 0;
+      disPrepare();
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (s_dis.len == 0) {
+      return true;
+    }
+    s_dis.phase = 1;
+    s_dis.start = now();
+    s_dis.count = 0;
+    shake(200);
+    return true;
+  }
+  if (e == Events::Up || e == Events::Down) {
+    s_dis.preset = (s_dis.preset + (e == Events::Down ? 1 : k_numberOfVictims - 1)) %
+                   k_numberOfVictims;
+    Str w(s_dis.word, sizeof(s_dis.word));
+    w.add(k_victims[s_dis.preset]);
+    s_dis.len = w.len;
+    disPrepare();
+    return true;
+  }
+  if (e == Events::Backspace) {
+    if (s_dis.len > 0) {
+      s_dis.word[--s_dis.len] = 0;
+      disPrepare();
+    }
+    return true;
+  }
+  const char* t = e.text();
+  if (t && t[0] && !t[1] && s_dis.len < 12) {
+    char c = t[0];
+    if (c >= 'a' && c <= 'z') {
+      c = static_cast<char>(c - 'a' + 'A');
+    }
+    if ((c >= 'A' && c <= 'Z') || c == ' ' || (c >= '0' && c <= '9')) {
+      s_dis.word[s_dis.len++] = c;
+      s_dis.word[s_dis.len] = 0;
+      disPrepare();
+    }
+  }
+  return true;
+}
+
+void updateDesintegrateur() {
+  if (s_dis.phase != 1) {
+    return;
+  }
+  uint32_t t = now();
+  uint32_t prev = t > 30 ? t - 30 : 0;
+  int x0 = disX0();
+  for (int my = 0; my < s_dis.h; my++) {
+    for (int mx = 0; mx < s_dis.w; mx++) {
+      if (!disBit(mx, my)) {
+        continue;
+      }
+      uint32_t r = disRelease(mx, my);
+      if (r > prev && r <= t) {
+        s_dis.count++;
+        addParticle(x0 + mx * k_disScale, k_disY + my * k_disScale,
+                    static_cast<int>(rnd() % 60) - 10,
+                    -static_cast<int>(rnd() % 50),
+                    static_cast<uint16_t>(marble(mx, my)), 200 + (rnd() & 55),
+                    Drift);
+      }
+    }
+  }
+  if (t > s_dis.start + 200 + 1400 + 600 + 300) {
+    s_dis.phase = 2;
+    s.vaporized += s_dis.count;
+  }
+}
+
+/* ========================================================== BATAILLE */
+
+const char* const k_ammo[] = {"Boulet", "Bombe à eau", "Boule de lave",
+                              "TNT", "Acide"};
+
+constexpr int k_fortX[2] = {16, 143};
+
+int groundAt(int x) {
+  int y = 0;
+  while (y < H && World::at(x, y) == Air) {
+    y++;
+  }
+  return y;
+}
+
+void battleTerrain() {
+  World::clear();
+  World::setGravity(0);
+  World::openFloor(false);
+  float a = frnd() * 6, b = frnd() * 6;
+  for (int x = 0; x < W; x++) {
+    float h = 22 + 8 * sinf(x * 0.05f + a) + 4 * sinf(x * 0.13f + b);
+    // a valley in the middle, plateaus for the forts
+    float mid = (x - 80) / 80.f;
+    h += 10 * (mid * mid) - 4;
+    int top = H - static_cast<int>(h);
+    for (int y = H - 1; y >= top; y--) {
+      World::set(x, y, y > H - 6 ? Stone : Sand);
+    }
+  }
+  for (int p = 0; p < 2; p++) {
+    int cx = k_fortX[p];
+    int g = groundAt(cx);
+    // a stone base, a wooden tower, a gold king on top
+    for (int y = g - 1; y >= g - 4; y--) {
+      for (int x = cx - 7; x <= cx + 7; x++) {
+        World::set(x, y, Stone);
+      }
+    }
+    for (int y = g - 5; y >= g - 14; y--) {
+      for (int x = cx - 4; x <= cx + 4; x++) {
+        World::set(x, y, Wood);
+      }
+    }
+    for (int y = g - 15; y >= g - 17; y--) {
+      for (int x = cx - 1; x <= cx + 1; x++) {
+        World::set(x, y, Gold);
+      }
+    }
+  }
+}
+
+int kingAlive(int p) {
+  int n = 0;
+  int x0 = p == 0 ? 0 : W / 2, x1 = p == 0 ? W / 2 : W;
+  for (int y = 0; y < H; y++) {
+    for (int x = x0; x < x1; x++) {
+      n += World::at(x, y) == Gold;
+    }
+  }
+  return n;
+}
+
+void newTurn() {
+  s_bat.phase = 0;
+  s_bat.wind = static_cast<int>(rnd() % 11) - 5;
+  s_bat.phaseStart = now();
+}
+
+void battleStart() {
+  battleTerrain();
+  s_bat.turn = 0;
+  s_bat.winner = -1;
+  s_bat.shots = 0;
+  for (int p = 0; p < 2; p++) {
+    s_bat.angle[p] = 45;
+    s_bat.power[p] = 60;
+    s_bat.ammo[p] = 0;
+    s_bat.tnt[p] = 2;
+  }
+  newTurn();
+}
+
+void cannonOrigin(int p, float* x, float* y) {
+  int g = groundAt(k_fortX[p] + (p == 0 ? 6 : -6));
+  *x = k_fortX[p] + (p == 0 ? 6.f : -6.f);
+  *y = g - 2.f;
+}
+
+void launchVelocity(int p, float* vx, float* vy) {
+  float a = s_bat.angle[p] * 3.14159f / 180;
+  float sp = s_bat.power[p] * 0.032f;
+  *vx = cosf(a) * sp * (p == 0 ? 1 : -1);
+  *vy = -sinf(a) * sp;
+}
+
+constexpr float k_gravity = 0.045f;
+
+void impact(int x, int y) {
+  x = clampi(x, 0, W - 1);
+  y = clampi(y, 0, H - 1);
+  switch (s_bat.ammo[s_bat.turn]) {
+    case 0:
+      World::explode(x, y, 4);
+      World::blob(x, y, 2, Stone, 200, false);
+      break;
+    case 1:
+      World::blob(x, y - 2, 6, Water, 230, false);
+      break;
+    case 2:
+      World::blob(x, y - 1, 4, Lava, 230, true);
+      break;
+    case 3:
+      World::explode(x, y, 9);
+      shake(700);
+      flash(0xFFFFFF, 150);
+      break;
+    default:
+      World::blob(x, y - 1, 4, Acid, 230, true);
+      break;
+  }
+  shake(300);
+}
+
+void updateBataille() {
+  World::step(now());
+  if (s_bat.phase == 1) {
+    for (int k = 0; k < 2; k++) {
+      s_bat.vy += k_gravity / 2;
+      s_bat.vx += s_bat.wind * 0.0008f;
+      s_bat.px += s_bat.vx / 2;
+      s_bat.py += s_bat.vy / 2;
+      int cx = static_cast<int>(s_bat.px), cy = static_cast<int>(s_bat.py);
+      if (cx < 0 || cx >= W || cy >= H) {
+        if (cy >= H || cx < 0 || cx >= W) {
+          if (cy >= 0 && cy < H + 4 && cx >= 0 && cx < W) {
+            impact(cx, H - 1);
+          }
+          s_bat.phase = 2;
+          s_bat.phaseStart = now();
+          return;
+        }
+      }
+      if (cy >= 0) {
+        Mat m = World::at(cx, cy);
+        if (m != Air && m != Smoke && m != Fire) {
+          impact(cx, cy);
+          s_bat.phase = 2;
+          s_bat.phaseStart = now();
+          return;
+        }
+      }
+    }
+    addParticle(static_cast<int>(s_bat.px * k_cell),
+                static_cast<int>(s_bat.py * k_cell), 0, 0,
+                KDColor::RGB888(255, 220, 140), 90, Spark);
+  } else if (s_bat.phase == 2 && now() - s_bat.phaseStart > 1800) {
+    bool a = kingAlive(0) >= 4, b = kingAlive(1) >= 4;
+    if (!a || !b) {
+      s_bat.phase = 3;
+      s_bat.winner = (!a && !b) ? 2 : (a ? 0 : 1);
+      for (int k = 0; k < 4; k++) {
+        addParticle(60 + k * 70, 235, static_cast<int>(rnd() % 60) - 30,
+                    -400 - static_cast<int>(rnd() % 100), 0xFFFF, 255,
+                    Firework);
+      }
+      return;
+    }
+    s_bat.turn = 1 - s_bat.turn;
+    newTurn();
+  }
+}
+
+void renderBataille(Band& b) {
+  World::render(b, now());
+  Rect area = b.area();
+  KDColor colors[2] = {KDColor::RGB24(0x5AA0FF), KDColor::RGB24(0xFF6A5A)};
+  for (int p = 0; p < 2; p++) {
+    int g = groundAt(k_fortX[p]);
+    int ly = (g - 3) * k_cell - 18;
+    if (ly > area.y - 20 && ly < area.bottom()) {
+      outlinedText(b, p == 0 ? "J1" : "J2", k_fortX[p] * k_cell, ly,
+                   colors[p], Small, Align::Center);
+    }
+  }
+  if (s_bat.phase == 0) {
+    int p = s_bat.turn;
+    float x, y, vx, vy;
+    cannonOrigin(p, &x, &y);
+    launchVelocity(p, &vx, &vy);
+    // the cannon and the start of the trajectory
+    line(b, x * k_cell, y * k_cell, (x + vx * 4) * k_cell,
+         (y + vy * 4) * k_cell, 4, KDColor::RGB24(0x3A3A44));
+    for (int k = 0; k < 40; k++) {
+      vy += k_gravity;
+      x += vx;
+      y += vy;
+      if (k % 4 == 3) {
+        fill(b, {static_cast<int>(x * k_cell), static_cast<int>(y * k_cell),
+                 2, 2},
+             colors[p], 200 - k * 4);
+      }
+    }
+  }
+  if (s_bat.phase == 1) {
+    disc(b, static_cast<int>(s_bat.px * k_cell),
+         static_cast<int>(s_bat.py * k_cell), 3, KDColor::RGB24(0x202020));
+  }
+  if (area.y < 40) {
+    fill(b, {0, 0, 320, 34}, KDColor::RGB24(k_night), 170);
+    if (s_bat.phase == 3) {
+      const char* t = s_bat.winner == 2   ? "ÉGALITÉ : deux rois en poussière"
+                      : s_bat.winner == 0 ? "LE JOUEUR 1 GAGNE"
+                                          : "LE JOUEUR 2 GAGNE";
+      outlinedText(b, t, 160, 4, KDColor::RGB24(0xFFE060), Large, Align::Center);
+      text(b, "OK : revanche · Retour : quitter", 160, 22,
+           KDColor::RGB24(k_ink), Small, Align::Center);
+    } else {
+      int p = s_bat.turn;
+      char t[96];
+      Str m(t, sizeof(t));
+      m.add(p == 0 ? "J1" : "J2")
+          .add("  angle ")
+          .addInt(s_bat.angle[p])
+          .add("°  force ")
+          .addInt(s_bat.power[p])
+          .add("  ")
+          .add(k_ammo[s_bat.ammo[p]]);
+      if (s_bat.ammo[p] == 3) {
+        m.add(" (").addInt(s_bat.tnt[p]).add(")");
+      }
+      text(b, t, 6, 3, colors[p], Small);
+      char w[32];
+      Str mw(w, sizeof(w));
+      mw.add("vent ");
+      if (s_bat.wind == 0) {
+        mw.add("nul");
+      } else {
+        for (int k = 0; k < (s_bat.wind < 0 ? -s_bat.wind : s_bat.wind); k++) {
+          mw.add(s_bat.wind < 0 ? "<" : ">");
+        }
+      }
+      text(b, w, 6, 18, KDColor::RGB24(k_ink), Small);
+      text(b, "OK : FEU", 314, 18, KDColor::RGB24(k_dim), Small, Align::Right);
+    }
+  }
+}
+
+bool batailleEvent(Event e) {
+  if (e == Events::Back || e == Events::Home || e == Events::Toolbox) {
+    resetDesert();
+    back();
+    return true;
+  }
+  if (s_bat.phase == 3) {
+    if (e == Events::OK || e == Events::EXE) {
+      battleStart();
+    }
+    return true;
+  }
+  if (s_bat.phase != 0) {
+    return true;
+  }
+  int p = s_bat.turn;
+  if (e == Events::Up) {
+    s_bat.angle[p] = clampi(s_bat.angle[p] + 3, 0, 89);
+  } else if (e == Events::Down) {
+    s_bat.angle[p] = clampi(s_bat.angle[p] - 3, -30, 89);
+  } else if (e == Events::Right) {
+    s_bat.power[p] = clampi(s_bat.power[p] + (p == 0 ? 2 : -2), 10, 100);
+  } else if (e == Events::Left) {
+    s_bat.power[p] = clampi(s_bat.power[p] + (p == 0 ? -2 : 2), 10, 100);
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (s_bat.ammo[p] == 3) {
+      if (s_bat.tnt[p] <= 0) {
+        toast("Plus de TNT. Il fallait y penser avant.", 1500);
+        return true;
+      }
+      s_bat.tnt[p]--;
+    }
+    cannonOrigin(p, &s_bat.px, &s_bat.py);
+    launchVelocity(p, &s_bat.vx, &s_bat.vy);
+    s_bat.phase = 1;
+    s_bat.shots++;
+    shake(120);
+  } else {
+    const char* t = e.text();
+    if (t && t[0] >= '1' && t[0] <= '5' && !t[1]) {
+      s_bat.ammo[p] = t[0] - '1';
+    }
+  }
+  return true;
+}
