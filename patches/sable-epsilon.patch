+
+void Shell::attach(Memory* memory) {
+  g_mem = memory;
+  g_colors = memory ? memory->colors : nullptr;
+  setTextBuffer(memory ? memory->text : nullptr);
+  clearParticles();
+  bool first = !s.booted;
+  s.now = s.last = clockMs();
+  s_attached = true;
+  s_launch = k_noItem;
+  for (int k = 0; k < k_maxFalling; k++) {
+    s_falling[k].active = false;
+  }
+  if (first) {
+    s.booted = true;
+    s.random = 0x2545F491u ^ s.now;
+    World::init(s.now);
+    s.ledOn = true;
+    s.userBrightness = s_fake ? 200
+                              : GlobalPreferences::SharedGlobalPreferences()
+                                    ->brightnessLevel();
+    s.brightness = -1;
+    s.lastLaunched = -1;
+    s.foodSeen = Food::produced();
+    s.page = 0;
+    s.selected = 0;
+    s.curX = W / 2;
+    s.curY = H / 3;
+    s.brush = Sand;
+    s.brushSize = 2;
+    buildApps();
+    resetDesert();
+    prepareLogo();
+    setMode(Mode::Boot);
+  } else {
+    buildApps();
+    World::clearStatues();
+    int last = s.lastLaunched;
+    if (s.mode >= Mode::Sablier || s.mode == Mode::Labo ||
+        s.mode == Mode::Boot) {
+      s.mode = Mode::Home;
+    }
+    if (s.mode == Mode::God) {
+      s.mode = Mode::Home;
+    }
+    setMode(Mode::Home);
+    if (last >= 0 && last < s_numberOfApps) {
+      s.page = pageOfApp(last);
+      s.selected = slotOfApp(last);
+    }
+    if (g_colors && !s_fake) {
+      captureScreen();
+      World::freeze(s.now, k_freezeDuration);
+      s.returning = true;
+      s.returnStart = s.now;
+    } else {
+      startBuild();
+    }
+    s.building = false;
+  }
+  Shell::frame();
+#if !PLATFORM_DEVICE
+  const char* shots = getenv("SABLE_SHOTS");
+  if (shots && first) {
+    photoSession();
+    exit(0);
+  }
+#endif
+}
+
+void Shell::detach() {
+  restoreLed();
+  if (s.brightness != s.userBrightness && !s_fake) {
+    Ion::Backlight::setBrightness(s.userBrightness);
+  }
+  s.brightness = s.userBrightness;
+  // The statues and the colors live in the App object, which goes away
+  World::clearStatues();
+  World::openFloor(false);
+  for (int k = 0; k < k_maxFalling; k++) {
+    if (s_falling[k].active) {
+      land(s_falling[k]);
+    }
+  }
+  s.building = false;
+  s.returning = false;
+  g_colors = nullptr;
+  g_mem = nullptr;
+  setTextBuffer(nullptr);
+  s_attached = false;
+}
