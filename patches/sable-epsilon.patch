+#include <stdint.h>
+
+/* SABLE: the Calculation app pushes every new
+ * result here, and they fall from the sky of the desert when you come
+ * back. A small ring: only the last results are kept, as text. */
+
+namespace Home {
+namespace Sable {
+namespace Food {
+
+constexpr int k_textSize = 28;
+constexpr int k_ringSize = 8;
+
+struct Entry {
+  char input[k_textSize];
+  char output[k_textSize];
+};
+
+void push(const char* input, const char* output);
+// Number of results pushed since the calculator started
+uint32_t produced();
+// Entry number `index`, nullptr if it is not kept anymore
+const Entry* at(uint32_t index);
+
+}  // namespace Food
+}  // namespace Sable
+}  // namespace Home
